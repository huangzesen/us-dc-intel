              <div class="l"><span class="en">Source URLs</span><span class="zh">数据来源链接</span></div>
            </div>
            <div class="stat">
              <div class="v" id="cCty">0</div>
              <div class="l" id="cCtyLabel"></div>
            </div>
            <div class="stat">
              <div class="v">{data.totals.countries_with_projects.toLocaleString("en-US")}</div>
              <div class="l"><span class="en">Countries &amp; territories with projects</span><span class="zh">有项目的国家与地区</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <div class="kick"><span class="idx">01</span><span class="en">GEOGRAPHY</span><span class="zh">地理分布</span></div>
              <h2><span class="en">Where the gigawatts are going</span><span class="zh">吉瓦流向何处</span></h2>
            </div>
            <div class="note"><span class="en">Click a country or state to change the scope.</span><span class="zh">点击国家或州切换分析范围。</span></div>
            <div class="tabs" style="margin:0 0 0 auto">
              <button id="mm-mw" class="on" data-map-metric="mw"><span class="en">CAPACITY GW</span><span class="zh">容量 GW</span></button>
              <button id="mm-n" data-map-metric="n"><span class="en">FACILITIES</span><span class="zh">设施数</span></button>
            </div>
          </div>
          <div class="card rv">
