          </div>
          <div class="kick">
            <span class="idx">00</span>
            <span class="en">TRACKING THE GLOBAL COMPUTE BUILDOUT</span>
            <span class="zh">追踪全球算力大基建</span>
          </div>
          <div class="countrybar" id="countrySwitch" aria-label="country scope"></div>
          <div class="big">
            <span id="heroGW">0.0</span>
            <span class="unit"><span id="heroUnit">GW</span> <span class="en">TRACKED</span><span class="zh">追踪容量</span></span>
            <!-- §8: announces the settled figure on scope changes; the
                 odometer digits themselves stay aria-hidden. -->
