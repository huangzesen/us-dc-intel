        font: 12px var(--mono);
      }
      td.cap {
        white-space: nowrap;
      }
      .capv {
        font: 600 13px var(--mono);
      }
      .capbar {
        display: block;
        width: 120px;
        height: 3px;
        margin-top: 4px;
        overflow: hidden;
        border-radius: 2px;
        background: var(--sf2);
      }
      .capbar i {
        display: block;
        height: 100%;
        border-radius: 2px;
        background: var(--b2);
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border: 1px solid;
        border-radius: 99px;
        white-space: nowrap;
        font: 11px var(--mono);
        letter-spacing: 0.03em;
      }
      .chip .cdot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
      }
      .evbar i {
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.9s cubic-bezier(0.25, 0.7, 0.25, 1);
        transition-delay: var(--d, 0s);
      }
      .in .evbar i {
        transform: scaleX(1);
      }
      .evkey .lg {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .evkey .sw {
        width: 11px;
        height: 11px;
        border-radius: 3px;
      }
      /* ——— Slice 9 (P3) part 2: a11y + mobile ——— */
      /* §8: one visible keyboard-focus ring everywhere. :where() keeps
         specificity at zero so component styles can still layer on top. */
      :where(button, input, select, a, th, tr, [tabindex]):focus-visible {
        outline: 2px solid var(--acc);
        outline-offset: 2px;
      }
      /* §7.4: touch devices pan the map with two fingers so one-finger
         swipes keep scrolling the page; this overlay says so when a
         single-finger drag is attempted. */
      .maphint {
        position: absolute;
        inset: 0;
        z-index: 1200;
        display: grid;
        place-items: center;
        padding: 20px;
        background: color-mix(in srgb, var(--bg) 55%, transparent);
        color: var(--ink);
        text-align: center;
        font: 13px var(--mono);
        letter-spacing: 0.08em;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s;
      }
      .maphint.show {
        opacity: 1;
      }
      @media (max-width: 680px) {
        /* §7.2: collapse the country strip to the ⌘K chip + active scope. */
        .countrybar button[data-country]:not(.on) {
          display: none;
        }
        .tile .tv {
          display: none;
        }
        /* §3.2 palette as a full-width sheet on phones. */
        .cmdk {
          padding: 0;
        }
        .cmdk-box {
          width: 100%;
          border-radius: 0 0 14px 14px;
        }
        /* §7.3: registry rows become stacked cards instead of an 820px-wide
           horizontal-scroll table. The virtualizer needs one uniform row
           height, so the card height is pinned (overflow hidden) and
           renderWindow adopts the measured value. */
        .tblwrap table {
          display: block;
          min-width: 0;
        }
        .tblwrap thead {
          display: none;
        }
        .tblwrap tbody {
          display: block;
        }
        #tbody tr.vpad {
          display: block;
        }
        #tbody tr.vpad td {
          display: block;
        }
        #tbody tr.vrow {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto auto;
          align-items: center;
          row-gap: 4px;
          column-gap: 10px;
          height: 108px;
          padding: 10px 2px 0;
          overflow: hidden;
          border-bottom: 1px solid var(--ln);
        }
        #tbody tr.vrow td {
          display: block;
          height: auto;
          padding: 0;
          border: 0;
        }
        #tbody tr.vrow td.proj {
          grid-row: 1;
          grid-column: 1 / -1;
          max-width: none;
        }
        #tbody tr.vrow td.proj b,
        #tbody tr.vrow td.proj .own {
          max-width: 100%;
        }
        #tbody tr.vrow td.cap {
          grid-row: 2;
          grid-column: 1;
        }
        /* The classless 4th cell is the status chip. */
        #tbody tr.vrow td:nth-child(4) {
          grid-row: 2;
          grid-column: 2 / -1;
          justify-self: end;
        }
        #tbody tr.vrow td.geo {
          grid-row: 3;
          grid-column: 1;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        #tbody tr.vrow td.yr {
          grid-row: 3;
          grid-column: 2;
        }
        #tbody tr.vrow td.gr {
          grid-row: 3;
          grid-column: 3;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <div class="brand">
          <span class="blk"></span>
