    <script id="gw-data" type="application/json" data-base={baseUrl} set:html={dataJson}></script>
    <script src={`${leafletBase}leaflet.js`} is:inline></script>
    <script is:inline>
      const DATA = JSON.parse(document.getElementById("gw-data").textContent);
      const BASE = (document.getElementById("gw-data").dataset.base || "/").replace(/\/?$/, "/");
      // Payload split (plan §6.1-6.2): the inline JSON carries aggregates only.
      // The full registry (centers + counties) arrives from data/centers.json
      // after first paint; until then the table runs on the flagship rows.
      DATA.centers = DATA.flagship || [];
      DATA.counties = [];
      let corpusPromise = null;
      const I18N = {
        st: DATA.status_labels,
        facilities: ["facilities", "个设施"],
        projects: ["projects", "个项目"],
        all: ["All statuses", "全部状态"],
        allStates: ["All states", "全部州"],
        showing: ["Showing", "显示"],
        of: ["of", "/ 共"],
        records: ["records", "条记录"],
        searchPh: ["SEARCH NAME / COUNTRY / AREA / DEVELOPER", "搜索 名称 / 国家 / 地区 / 开发商"],
        searchClear: ["clear search", "清除搜索"],
        noMatch: ["No records match the current filters.", "没有符合当前筛选的记录。"],
        worldwide: ["Worldwide", "全球"],
        allSubnational: ["All areas", "全部地区"],
        largest: ["largest pipeline", "最大储备"],
        mostFacilities: ["most facilities", "设施数最多"],
        countriesWithProjects: ["Countries with projects", "有项目的国家"],
        subnationalsWithProjects: ["Areas with projects", "有项目的地区"],
        countyDrill: ["County drilldown", "县级下钻"],
        countyApprox: ["County coordinate missing; using the state centroid.", "县级坐标缺失，使用州质心近似。"],
        tracked: ["Tracked", "已知"],
        estimated: ["estimated (mean fill)", "均值估算"],
        trackedShort: ["trk", "已知"],
        estimatedShort: ["est(mean)", "均值"],
        worldwideSub: [
          `Global data-center buildout across ${DATA.totals.countries_with_projects.toLocaleString("en-US")} countries and territories with projects.`,
          `覆盖全球 ${DATA.totals.countries_with_projects.toLocaleString("en-US")} 个有项目国家与地区的数据中心建设总盘。`
        ],
        countrySub: ["Focused country view with subnational distribution and filtered project signals.", "国家聚焦视图，展示该国内地区分布和过滤后的项目信号。"],
        ev: {
          official: ["Official (county / permit / utility)", "官方（县政/许可/电力）"],
          news: ["News media", "新闻媒体"],
          tracker: ["Industry trackers", "行业追踪"],
          other: ["Social & other", "社媒及其他"]
        },
        dc: {
          noDetail: ["No detail record — basic fields only", "无详情记录 — 仅基础字段"],
          loading: ["Loading detail record…", "详情记录加载中…"],
          capacity: ["Capacity", "容量"],
          status: ["Status", "状态"],
          owner: ["Owner", "运营方"],
          developer: ["Developer", "开发商"],
          location: ["Location", "位置"],
          evidence: ["Evidence", "证据"],
          evidenceGrade: ["Evidence grade", "证据等级"],
          evidenceDate: ["Evidence date", "证据日期"],
          sources: ["Sources", "来源"],
          notes: ["Notes", "备注"],
          estBadge: ["~est", "~估"],
          estTitle: ["estimated capacity", "估算容量"],
          devScope: ["filter the registry to this operator, worldwide", "在全球范围筛选该开发商的项目"]
        },
        legMW: ["<1 GW", "1-5 GW", "5-15 GW", "15-45 GW", "45+ GW"],
        legN: ["<20", "20-49", "50-89", "90-149", "150+"]
      };

      const qs = new URLSearchParams(location.search);
      const noMotion = matchMedia("(prefers-reduced-motion: reduce)").matches || qs.has("noanim");
      const coarsePointer = matchMedia("(pointer: coarse)").matches;
      const tip = document.getElementById("tip");
      let mapMetric = "mw";
      let selState = null;
      let selCountry = null;
      let devTab = "mw";
      let sortKey = "mw";
      let sortDir = -1;
      let currentRows = [];
      let realMap = null;
      let realMapLayer = null;
      let realTileLayer = null;
      let realCanvas = null;
      let realMarkers = [];
      let mapTouchHint = null;

      const langIndex = () => document.documentElement.dataset.lang === "zh" ? 1 : 0;
      const L = value => Array.isArray(value) ? value[langIndex()] : value;
      const fmt = value => Number(value).toLocaleString("en-US");
      const fmtMW = mw => mw >= 1000 ? `${(mw / 1000).toFixed(mw >= 10000 ? 1 : 2).replace(/\.?0+$/, "")} GW` : `${fmt(Math.round(mw))} MW`;
      const gwOf = (src, mwKey, gwKey) => src?.[gwKey] != null ? Number(src[gwKey]) : (Number(src?.[mwKey]) || 0) / 1000;
      const splitFull = (tGw, eGw) => `${(Number(tGw) || 0).toFixed(1)} GW ${L(I18N.tracked)} + ${(Number(eGw) || 0).toFixed(1)} GW ${L(I18N.estimated)}`;
      const splitList = (tGw, eGw) => `<small>(${(Number(tGw) || 0).toFixed(1)}G ${L(I18N.trackedShort)} + ${(Number(eGw) || 0).toFixed(1)}G ${L(I18N.estimatedShort)})</small>`;
      const splitSuffix = (tGw, eGw) => ` (${(Number(tGw) || 0).toFixed(1)}G + ${(Number(eGw) || 0).toFixed(1)}G ${L(I18N.estimatedShort)})`;
      const stColor = key => `var(--st-${key})`;
      const esc = value => String(value ?? "").replace(/[&<>"']/g, ch => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" })[ch]);
      const buildRowBySlug = () => new Map(DATA.centers.filter(c => c.slug).map(c => [c.slug, c]));
      let rowBySlug = buildRowBySlug();
      const statusShort = { operational: "op", announced: "ann", planned: "pla", approved: "app", construction: "con", rejected: "rej", unknown: "unk" };
      const statusLabel = status => {
        if (!status) return "—";
        if (I18N.st[status]) return I18N.st[status][langIndex()];
        const s = String(status).toLowerCase();
        for (const full of Object.keys(statusShort)) {
          if (s.includes(full)) return I18N.st[statusShort[full]][langIndex()];
        }
        return esc(String(status));
      };
      const countryByCode = new Map((DATA.countries || []).map(c => [c.code, c]));
      const stateByAbbr = new Map((DATA.states || []).map(s => [s.abbr, s]));
      const buildCountiesByState = () => (DATA.counties || []).reduce((acc, county) => {
        (acc[county.state_abbr] ||= []).push(county);
        return acc;
      }, {});
      let countiesByState = buildCountiesByState();

      function loadCorpus() {
        if (corpusPromise) return corpusPromise;
        corpusPromise = fetch(`${BASE}data/centers.json`)
          .then(r => {
            if (!r.ok) throw new Error(`centers.json ${r.status}`);
            return r.json();
          })
          .then(payload => {
            DATA.centers = payload.centers || [];
            DATA.counties = payload.counties || [];
            rowBySlug = buildRowBySlug();
            countiesByState = buildCountiesByState();
            document.getElementById("lazyNote").hidden = true;
            buildFilters();
            renderTable();
            corpusReady = true;
            syncDotToggle();
            updateFacilityDots();
            if (!cmdkEl.hidden) cmdkUpdate();
            // County drilldown is the only map view fed by the deferred chunk;
            // other scopes keep their viewport untouched.
            if (selCountry === "US" && selState) {
              renderRealMap();
              updateMapSide();
            }
          })
          .catch(() => {
            corpusPromise = null;
            document.getElementById("lazyNote").hidden = true;
          });
        return corpusPromise;
      }
      const selectedCountry = () => selCountry ? countryByCode.get(selCountry) : null;
      const scopedFunnel = () => selectedCountry()?.funnel || DATA.funnel;
      const scopedTotals = () => {
        const country = selectedCountry();
        const src = country || DATA.totals;
        return {
          capacity_mw: src.capacity_mw,
          capacity_gw: src.capacity_gw,
          facilities: src.facilities,
          projects_geo: country ? country.subnationals.length : DATA.totals.countries_with_projects,
          geo_label: country ? I18N.subnationalsWithProjects : I18N.countriesWithProjects,
          tracked_gw: gwOf(src, "tracked_mw", "tracked_gw"),
          est_gw: gwOf(src, "est_mw", "est_gw"),
        };
      };
      const countryName = country => langIndex() ? country.name_zh : country.name_en;
      const hasCoord = item => item?.lat != null && item?.lng != null && Number.isFinite(Number(item.lat)) && Number.isFinite(Number(item.lng));
      const pointValue = item => mapMetric === "mw" ? Number(item.capacity_mw || 0) : Number(item.facilities || 0);
      // Marker system (plan §5.2): color rides the same sequential blue
      // capacity ramp as the tile cartogram (MW_BINS -> --b0..--b4) and
      // opacity climbs with the band; amber is reserved for the selected
      // geography. Tokens resolve at render time so both themes stay true.
      const MARKER_RAMP = ["--b0", "--b1", "--b2", "--b3", "--b4"];
      function markerPalette() {
        const cs = getComputedStyle(document.documentElement);
        return { ramp: MARKER_RAMP.map(t => cs.getPropertyValue(t).trim()), acc: cs.getPropertyValue("--acc").trim() };
      }
      const markerBand = item => binOf(Number(item.capacity_mw || 0), MW_BINS);
      function markerStyleFor(pal, item, selected) {
        if (selected) return { color: pal.acc, fillColor: pal.acc, weight: 3, opacity: 1, fillOpacity: 0.85 };
        const band = markerBand(item);
        return {
          color: pal.ramp[Math.min(band + 1, 4)],
          fillColor: pal.ramp[band],
          weight: 1.5,
          opacity: 0.9,
          fillOpacity: 0.5 + band * 0.09,
        };
      }
      const markerRadius = item => {
        const value = pointValue(item);
        return Math.max(6, Math.min(28, 5 + Math.sqrt(Math.max(0, value)) * (mapMetric === "mw" ? 0.07 : 1.2)));
      };

      // Facility dot layer (plan §5.3): one canvas dot per corpus row, shown
      // past DOT_MIN_ZOOM once the lazy corpus lands. Rows carry no exact
      // coordinates, so each dot anchors to its US county centroid (state
      // centroid fallback) or its country anchor, spread with the same
      // deterministic golden-angle jitter as subnational anchors — positions
      // are approximate by design and labelled as such. Color rides the §5.2
      // blue ramp, re-binned to facility grain (aggregate bins start at 1 GW,
      // which would flatten nearly every facility into band 0).
      const DOT_BINS = [30, 100, 300, 1000];
      const DOT_MIN_ZOOM = 6;
      let corpusReady = false;
      let dotsEnabled = true;
      let dotLayer = null;
      let dotRecords = [];
      function dotStyleFor(pal, c) {
        const band = binOf(Number(c.capacity_mw || 0), DOT_BINS);
        return {
          color: pal.ramp[Math.min(band + 1, 4)],
          fillColor: pal.ramp[band],
          weight: 1,
          opacity: 0.85,
          fillOpacity: 0.55 + band * 0.08,
        };
      }
      const dotRadius = c => Math.max(1.8, Math.min(7, 1.4 + Math.sqrt(Math.max(0, Number(c.capacity_mw || 0))) * 0.09));
      function facilityAnchor(c) {
        if (c.country === "US") {
          const county = (countiesByState[c.state] || []).find(k => k.county === c.county);
          if (county && hasCoord(county)) return { lat: Number(county.lat), lng: Number(county.lng), spread: 0.045 };
          const state = stateByAbbr.get(c.state);
          if (hasCoord(state)) return { lat: Number(state.lat), lng: Number(state.lng), spread: 0.4 };
        }
        const country = countryByCode.get(c.country);
        if (hasCoord(country)) return { lat: Number(country.lat), lng: Number(country.lng), spread: 0.8 };
        return null;
      }
      const facilityTipHTML = c => {
        const loc = [c.county, c.subnational || c.state, c.country].filter(Boolean).join(", ");
        return `<div class="t1">${esc(c.project)}</div><div class="t2">${esc(loc)} · ${fmtMW(c.capacity_mw)}<br>${langIndex() ? "位置为近似坐标（县/国家锚点）" : "Approximate position (county/country anchor)"}</div>`;
      };
      function buildDotLayer() {
        dotLayer = window.L.layerGroup();
        dotRecords = [];
        const pal = markerPalette();
        const groupIndex = new Map();
        DATA.centers.forEach(c => {
          const anchor = facilityAnchor(c);
          if (!anchor) return;
          const key = `${anchor.lat},${anchor.lng}`;
          const idx = groupIndex.get(key) || 0;
          groupIndex.set(key, idx + 1);
          const angle = idx * 2.399963;
          const ring = idx === 0 ? 0 : anchor.spread * (0.25 + 0.75 * Math.sqrt((idx % 64) / 64));
          const style = dotStyleFor(pal, c);
          const marker = window.L.circleMarker([anchor.lat + Math.sin(angle) * ring, anchor.lng + Math.cos(angle) * ring], {
            renderer: realCanvas,
            radius: dotRadius(c),
            ...style,
          });
          const record = { marker, item: c, style };
          marker.on("mouseover", ev => {
            marker.setStyle({ weight: 2, fillOpacity: 1 });
            showTip(facilityTipHTML(c), ev.originalEvent);
          });
          marker.on("mousemove", ev => showTip(facilityTipHTML(c), ev.originalEvent));
          marker.on("mouseout", () => {
            marker.setStyle(record.style);
            hideTip();
          });
          marker.on("click", () => {
            hideTip();
            openDcDetail(c.slug || "", c);
          });
          dotRecords.push(record);
          marker.addTo(dotLayer);
        });
      }
      function updateFacilityDots() {
        if (!realMap) return;
        const show = corpusReady && dotsEnabled && realMap.getZoom() >= DOT_MIN_ZOOM;
        if (show && !dotLayer) buildDotLayer();
        if (!dotLayer) return;
        const onMap = realMap.hasLayer(dotLayer);
        if (show && !onMap) dotLayer.addTo(realMap);
        else if (!show && onMap) realMap.removeLayer(dotLayer);
      }
      function syncDotToggle() {
        const chip = document.getElementById("dotToggle");
        chip.hidden = !corpusReady;
        chip.classList.toggle("on", dotsEnabled);
        chip.setAttribute("aria-pressed", String(dotsEnabled));
        chip.textContent = `● ${fmt(DATA.centers.length)} ${langIndex() ? "设施" : "FACILITIES"}`;
        chip.title = langIndex()
          ? `设施圆点在缩放级别 ≥ ${DOT_MIN_ZOOM} 时显示；坐标为近似锚点。点击开关。`
          : `Facility dots appear at zoom ≥ ${DOT_MIN_ZOOM}; positions are approximate anchors. Click to toggle.`;
      }

      const cartoTileUrl = theme => `https://{s}.basemaps.cartocdn.com/${theme === "light" ? "light_all" : "dark_all"}/{z}/{x}/{y}{r}.png`;

      function syncMapTiles() {
        if (realTileLayer) realTileLayer.setUrl(cartoTileUrl(document.documentElement.dataset.theme));
      }

      // Theme flips restyle markers in place (no re-render, no viewport jump):
      // the ramp tokens differ per theme, so styles are recomputed and applied.
      function syncMarkerTheme() {
        if (!realMarkers.length && !dotRecords.length) return;
        const pal = markerPalette();
        realMarkers.forEach(record => {
          record.style = markerStyleFor(pal, record.item, record.selected);
          record.marker.setStyle(record.style);
        });
        dotRecords.forEach(record => {
          record.style = dotStyleFor(pal, record.item);
          record.marker.setStyle(record.style);
        });
      }

      function setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        document.getElementById("th-dark").classList.toggle("on", theme === "dark");
        document.getElementById("th-light").classList.toggle("on", theme === "light");
        try {
          localStorage.setItem("gw-theme", theme);
        } catch (error) {}
        syncMapTiles();
        syncMarkerTheme();
        if (heroRendered) renderHeroCapacity(scopedTotals().capacity_gw);
      }

      function setLang(nextLang) {
        document.documentElement.dataset.lang = nextLang;
        document.documentElement.lang = nextLang === "zh" ? "zh-CN" : "en";
        document.getElementById("lg-en").classList.toggle("on", nextLang === "en");
        document.getElementById("lg-zh").classList.toggle("on", nextLang === "zh");
        try {
          localStorage.setItem("gw-lang", nextLang);
        } catch (error) {}
        buildMap();
        renderRealMap();
        buildFilters();
        renderTable();
        buildDevs();
        buildEvidence();
        buildCountrySwitch();
        buildTreemap();
        updateHero();
        updateMapSide();
        updateFunnelTitle();
        syncDotToggle();
        buildTicker();
      }

      function showTip(html, ev) {
        tip.innerHTML = html;
        tip.style.opacity = 1;
        const pad = 14;
        const width = tip.offsetWidth;
        const height = tip.offsetHeight;
        let x = ev.clientX + pad;
        let y = ev.clientY + pad;
        if (x + width > innerWidth - 8) x = ev.clientX - width - pad;
        if (y + height > innerHeight - 8) y = ev.clientY - height - pad;
        tip.style.left = `${x}px`;
        tip.style.top = `${y}px`;
      }

      function hideTip() {
        tip.style.opacity = 0;
      }

      function countUp(el, target, decimals, dur) {
        if (noMotion) {
          el.textContent = decimals ? target.toFixed(decimals) : fmt(target);
          return;
        }
        const start = performance.now();
        const tick = now => {
          const p = Math.min(1, (now - start) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          const v = target * e;
          el.textContent = decimals ? v.toFixed(decimals) : fmt(Math.round(v));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Hero counter (plan §2.2): auto-unit to TW past 1,000 GW, with the
      // honest GW equivalence printed underneath. Digits render as odometer
      // columns; the eased count-up drives each 0-9 strip, whose short CSS
      // transition turns discrete digit changes into a roll. Re-animates on
      // scope, language, and theme changes.
      let heroRendered = false;
      let heroAnimToken = 0;
      function renderHeroCapacity(gw) {
        const total = Number(gw) || 0;
        const isTW = total >= 1000;
        const target = isTW ? total / 1000 : total;
        const decimals = isTW ? 2 : 1;
        const targetStr = target.toFixed(decimals);
        document.getElementById("heroUnit").textContent = isTW ? "TW" : "GW";
        document.getElementById("heroEq").textContent = isTW
          ? `= ${total.toLocaleString("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} GW`
          : "";
        const el = document.getElementById("heroGW");
        el.setAttribute("aria-label", `${targetStr} ${isTW ? "TW" : "GW"}`);
        // §8: the odometer digits are aria-hidden; announce the settled
        // figure through the polite live region instead.
        document.getElementById("heroLive").textContent = `${targetStr} ${isTW ? "TW" : "GW"} ${langIndex() ? "追踪容量" : "tracked"}`;
        const strip = Array.from({ length: 10 }, (_, d) => `<span>${d}</span>`).join("");
        el.innerHTML = targetStr.split("").map(ch => /\d/.test(ch)
          ? `<span class="od" aria-hidden="true"><span class="odp">${ch}</span><span class="ods">${strip}</span></span>`
          : `<span aria-hidden="true">${ch}</span>`).join("");
        const strips = [...el.querySelectorAll(".ods")];
        const setDigits = value => {
          const digits = value.toFixed(decimals).replace(/[^0-9]/g, "").padStart(strips.length, "0");
          strips.forEach((s, i) => {
            const d = Number(digits[i]);
            if (s._d !== d) {
              s._d = d;
              // 1.02em per step = the .big line-height, i.e. one digit row.
              s.style.transform = `translateY(${(-d * 1.02).toFixed(2)}em)`;
            }
          });
        };
        heroRendered = true;
        const token = ++heroAnimToken;
        if (noMotion) {
          setDigits(target);
          return;
        }
        setDigits(0);
        const start = performance.now();
        const dur = 1800;
        const tick = now => {
          if (token !== heroAnimToken) return;
          const p = Math.min(1, (now - start) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          setDigits(target * e);
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      const MW_BINS = [1000, 5000, 15000, 45000];
      const N_BINS = [20, 50, 90, 150];
      const binOf = (v, bins) => bins.reduce((bin, th, i) => v >= th ? i + 1 : bin, 0);

      function setMapMetric(metric) {
        mapMetric = metric;
        document.getElementById("mm-mw").classList.toggle("on", metric === "mw");
        document.getElementById("mm-n").classList.toggle("on", metric === "n");
        buildMap();
        renderRealMap();
        updateMapSide();
        syncUrl();
      }

      function setCountry(code) {
        selCountry = selCountry === code ? null : code;
        selState = null;
        // URL state (plan §3.3): one pushState per scope change — the inner
        // renderTable would otherwise replace-write a half-settled hash.
        urlGeoPending = "";
        applyingUrl = true;
        buildCountrySwitch();
        updateHero();
        buildMap();
        renderRealMap();
        buildFunnel();
        buildFilters();
        renderTable();
        updateMapSide();
        updateFunnelTitle();
        applyingUrl = false;
        syncUrl(true);
      }

      function initRealMap() {
        if (realMap || !window.L) return Boolean(realMap);
        // Glow (plan §5.2): markers draw on a canvas renderer whose circle
        // pass adds a soft same-hue shadow (blur ≈ radius). Canvas also keeps
        // large marker counts cheap for the future facility layer.
        const GlowCanvas = window.L.Canvas.extend({
          _updateCircle(layer) {
            const ctx = this._ctx;
            if (!ctx || !layer.options.glow) return window.L.Canvas.prototype._updateCircle.call(this, layer);
            ctx.save();
            ctx.shadowBlur = Math.max(6, layer._radius || 0);
            ctx.shadowColor = layer.options.fillColor;
            window.L.Canvas.prototype._updateCircle.call(this, layer);
            ctx.restore();
          },
        });
        realCanvas = new GlowCanvas({ padding: 0.5 });
        realMap = window.L.map("realMap", {
          zoomControl: true,
          scrollWheelZoom: false,
          worldCopyJump: true,
        }).setView([18, -82], 3);
        realTileLayer = window.L.tileLayer(cartoTileUrl(document.documentElement.dataset.theme), {
          maxZoom: 18,
          subdomains: "abcd",
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        }).addTo(realMap);
        realMapLayer = window.L.layerGroup().addTo(realMap);
        realMap.on("zoomend", updateFacilityDots);
        // §7.4: on touch devices one-finger swipes keep scrolling the page —
        // the map pans with two fingers (pinch-zoom already does). A brief
        // overlay explains itself when a single-finger drag is attempted.
        // Fullscreen re-enables one-finger panning (no page to scroll).
        if (coarsePointer) {
          realMap.dragging.disable();
          mapTouchHint = document.createElement("div");
          mapTouchHint.className = "maphint";
          mapTouchHint.setAttribute("aria-hidden", "true");
          document.getElementById("realMap").appendChild(mapTouchHint);
          let hintTimer = null;
          const container = realMap.getContainer();
          container.addEventListener("touchstart", e => {
            if (document.fullscreenElement) return;
            if (e.touches.length >= 2) {
              realMap.dragging.enable();
              mapTouchHint.classList.remove("show");
            } else {
              realMap.dragging.disable();
            }
          }, { passive: true });
          container.addEventListener("touchmove", e => {
            if (document.fullscreenElement || e.touches.length !== 1) return;
            mapTouchHint.textContent = langIndex() ? "使用双指移动地图" : "USE TWO FINGERS TO MOVE THE MAP";
            mapTouchHint.classList.add("show");
            clearTimeout(hintTimer);
            hintTimer = setTimeout(() => mapTouchHint.classList.remove("show"), 1100);
          }, { passive: true });
        }
        setTimeout(() => realMap.invalidateSize(), 0);
        return true;
      }

      function realMapItems() {
        if (!selCountry) return (DATA.countries || []).filter(item => hasCoord(item) && pointValue(item) > 0);
        if (selCountry === "US" && selState) return (countiesByState[selState] || []).filter(item => hasCoord(item) && pointValue(item) > 0);
        if (selCountry === "US") return (DATA.states || []).filter(item => hasCoord(item) && pointValue(item) > 0);
        const country = selectedCountry();
        const center = hasCoord(country) ? country : null;
        return (country?.subnationals || []).filter(item => pointValue(item) > 0).map((item, index) => {
          if (hasCoord(item) && (!center || item.lat !== center.lat || item.lng !== center.lng)) return item;
          if (!center) return item;
          const ring = 0.7 + (index % 5) * 0.18;
          const angle = index * 2.399963;
          return {
            ...item,
            lat: Number(center.lat) + Math.sin(angle) * ring,
            lng: Number(center.lng) + Math.cos(angle) * ring,
            approximate_anchor: true,
          };
        }).filter(hasCoord);
      }

      function realMapPopup(item) {
        const title = item.code
          ? `${item.code} · ${countryName(item)}`
          : item.abbr
            ? `${item.abbr} · ${langIndex() ? item.name_zh : item.name_en}`
            : item.county
              ? `${item.county}, ${item.state_abbr}`
              : item.name;
        const top = item.subnationals?.slice(0, 5).map(s => `${esc(s.name)} ${fmtMW(s.capacity_mw)}`).join("<br>");
        const approximate = item.approximate_anchor
          ? `<div class="p3">${langIndex() ? "坐标为国家质心附近的近似锚点。" : "Approximate anchor near the country centroid."}</div>`
          : item.county && stateByAbbr.get(item.state_abbr)?.lat === item.lat && stateByAbbr.get(item.state_abbr)?.lng === item.lng
            ? `<div class="p3">${L(I18N.countyApprox)}</div>`
            : "";
        const area = item.county ? `<div class="p3">${esc(item.state || item.state_abbr)} · ${L(I18N.countyDrill)}</div>` : "";
        const estPart = item.est_mw !== undefined && item.est_mw !== null ? splitSuffix(gwOf(item, "tracked_mw", "tracked_gw"), gwOf(item, "est_mw", "est_gw")) : "";
        return `<div class="p1">${esc(title)}</div>
          <div class="p2">${fmt(item.facilities)} ${L(I18N.facilities)} · ${fmtMW(item.capacity_mw)}${estPart}</div>
          ${area}
          ${top ? `<div class="p3">${top}</div>` : ""}
          ${approximate}`;
      }

      function renderRealMap() {
        const titleEl = document.getElementById("realMapTitle");
        const noteEl = document.getElementById("realMapNote");
        if (!initRealMap()) {
          titleEl.textContent = langIndex() ? "地图库未加载" : "Map library unavailable";
          noteEl.textContent = langIndex() ? "Leaflet 加载失败时，保留原有地理视图。" : "The existing geographic view remains available if Leaflet fails to load.";
          return;
        }
        realMapLayer.clearLayers();
        realMarkers = [];
        const pal = markerPalette();
        const items = realMapItems();
        const bounds = [];
        items.forEach(item => {
          const latlng = [Number(item.lat), Number(item.lng)];
          bounds.push(latlng);
          const subActive = selCountry && selCountry !== "US" && document.getElementById("fState").value;
          const selected = (selCountry === "US" && item.abbr && item.abbr === selState) || (subActive && item.name === subActive);
          const style = markerStyleFor(pal, item, selected);
          const marker = window.L.circleMarker(latlng, {
            renderer: realCanvas,
            glow: true,
            radius: markerRadius(item),
            ...style,
          }).bindPopup(realMapPopup(item));
          const record = { marker, item, selected, style };
          realMarkers.push(record);
          marker.on("mouseover", () => marker.setStyle({ weight: record.style.weight + 1, fillOpacity: Math.min(1, record.style.fillOpacity + 0.18) }));
          marker.on("mouseout", () => marker.setStyle(record.style));
          marker.on("click", () => {
            if (!selCountry && item.code) setCountry(item.code);
            else if (selCountry === "US" && item.abbr) {
              selState = selState === item.abbr ? null : item.abbr;
              buildMap();
              renderRealMap();
              syncStateFilter();
            } else if (selCountry === "US" && item.county) {
              document.getElementById("fState").value = item.state_abbr;
              selState = item.state_abbr;
              buildMap();
              renderTable();
            } else if (selCountry && selCountry !== "US" && item.name) {
              document.getElementById("fState").value = item.name;
              renderRealMap();
              renderTable();
            }
          });
          marker.addTo(realMapLayer);
        });
        const country = selectedCountry();
        titleEl.textContent = !selCountry
          ? (langIndex() ? "全球国家亮点" : "Worldwide country highlights")
          : selCountry === "US"
            ? selState
              ? `${selState} · ${langIndex() ? "美国县级亮点" : "US county highlights"}`
              : (langIndex() ? "美国州级亮点" : "US state highlights")
            : `${countryName(country)} · ${langIndex() ? "地区亮点" : "subnational highlights"}`;
        noteEl.textContent = langIndex()
          ? (selCountry === "US" ? "美国视图先显示州级概览；点击州亮点后显示该州有项目的县级亮点。" : "圆点大小按当前指标非线性缩放，颜色按容量分级；点击亮点进入国家或地区筛选。")
          : (selCountry === "US" ? "The US view starts at state level; click a state marker to show project counties inside that state." : "Marker size uses nonlinear scaling for the active metric; color is capacity-banded. Click a highlight to focus.");
        if (bounds.length > 1) {
          realMap.flyToBounds(bounds, { padding: [28, 28], maxZoom: selCountry === "US" && selState ? 8 : selCountry ? 6 : 4, animate: !noMotion });
        } else if (bounds.length === 1) {
          realMap.flyTo(bounds[0], selCountry ? 5 : 3, { animate: !noMotion });
        }
      }

      function buildCountrySwitch() {
        const countries = [...(DATA.countries || [])].sort((a, b) => b.capacity_mw - a.capacity_mw || b.facilities - a.facilities);
        document.getElementById("countrySwitch").innerHTML = [
          `<button type="button" data-cmdk-open title="Cmd/Ctrl+K">⌘K ${langIndex() ? "搜索" : "SEARCH"}</button>`,
          `<button type="button" class="${selCountry ? "" : "on"}" data-country="">${L(I18N.worldwide)}</button>`,
          ...countries.map(c => `<button type="button" class="${selCountry === c.code ? "on" : ""}" data-country="${esc(c.code)}">${esc(c.code)} · ${esc(countryName(c))}</button>`)
        ].join("");
        document.querySelectorAll("[data-country]").forEach(button => button.addEventListener("click", () => setCountry(button.dataset.country || null)));
      }

      function updateHero() {
        const totals = scopedTotals();
        const country = selectedCountry();
        renderHeroCapacity(totals.capacity_gw);
        const heroSplitEl = document.getElementById("heroSplit");
        if (heroSplitEl) heroSplitEl.textContent = (Number(totals.tracked_gw) || 0) + (Number(totals.est_gw) || 0) > 0 ? splitFull(totals.tracked_gw, totals.est_gw) : "";
        document.getElementById("cFac").textContent = fmt(totals.facilities);
        document.getElementById("cSrc").textContent = fmt(DATA.totals.sources);
        document.getElementById("cCty").textContent = fmt(totals.projects_geo);
        document.getElementById("cCtyLabel").innerHTML = `<span class="en">${esc(totals.geo_label[0])}</span><span class="zh">${esc(totals.geo_label[1])}</span>`;
        document.getElementById("heroSub").textContent = country ? `${countryName(country)} · ${L(I18N.countrySub)}` : L(I18N.worldwideSub);
      }

      function buildMap() {
        const el = document.getElementById("usmap");
        const bins = mapMetric === "mw" ? MW_BINS : N_BINS;
        el.innerHTML = "";
        el.className = selCountry === "US" ? "usmap" : selCountry ? "subnatlist" : "countrygrid";
        if (!selCountry) {
          const countries = [...(DATA.countries || [])].sort((a, b) => b.capacity_mw - a.capacity_mw || b.facilities - a.facilities);
          const max = Math.max(1, ...countries.map(c => mapMetric === "mw" ? c.capacity_mw : c.facilities));
          el.innerHTML = countries.map(c => {
            const value = mapMetric === "mw" ? c.capacity_mw : c.facilities;
            return `<button type="button" class="geoitem" data-map-country="${esc(c.code)}">
              <span class="gt"><span class="gn">${esc(c.code)} · ${esc(countryName(c))}</span><span>${mapMetric === "mw" ? (c.est_mw > 0 ? `${fmtMW(c.capacity_mw)} ${splitList(gwOf(c, "tracked_mw", "tracked_gw"), gwOf(c, "est_mw", "est_gw"))}` : fmtMW(c.capacity_mw)) : fmt(c.facilities)}</span></span>
              <span class="gv">${fmt(c.facilities)} ${L(I18N.facilities)}</span>
              <span class="gbar"><i style="width:${Math.max(1.5, value / max * 100).toFixed(1)}%"></i></span>
            </button>`;
          }).join("");
          el.querySelectorAll("[data-map-country]").forEach(button => button.addEventListener("click", () => setCountry(button.dataset.mapCountry)));
          document.getElementById("mapLegend").innerHTML = "";
          document.getElementById("mapNoteText").textContent = langIndex()
            ? "全球国家列表按规模排序；点击国家进入聚焦视图。"
            : "Countries worldwide, sorted by magnitude. Click a country to focus.";
          return;
        }
        if (selCountry !== "US") {
          const country = selectedCountry();
          const rows = country?.subnationals || [];
          const max = Math.max(1, ...rows.map(r => mapMetric === "mw" ? r.capacity_mw : r.facilities));
          el.innerHTML = rows.map(r => {
            const value = mapMetric === "mw" ? r.capacity_mw : r.facilities;
            return `<div class="geoitem">
              <span class="gt"><span class="gn">${esc(r.name)}</span><span>${mapMetric === "mw" ? fmtMW(r.capacity_mw) : fmt(r.facilities)}</span></span>
              <span class="gv">${fmt(r.facilities)} ${L(I18N.facilities)}</span>
              <span class="gbar"><i style="width:${Math.max(1.5, value / max * 100).toFixed(1)}%"></i></span>
            </div>`;
          }).join("");
          document.getElementById("mapLegend").innerHTML = "";
          document.getElementById("mapNoteText").textContent = langIndex()
            ? "非美国国家使用地区条形列表，不依赖美国州方块网格。"
            : "Non-US countries use a subnational bar list instead of the US state tile grid.";
          return;
        }
        DATA.states.forEach(s => {
          const value = mapMetric === "mw" ? s.capacity_mw : s.facilities;
          const tile = document.createElement("button");
          tile.type = "button";
          tile.className = `tile b${binOf(value, bins)}${selState === s.abbr ? " sel" : ""}`;
          tile.style.gridRow = s.row + 1;
          tile.style.gridColumn = s.col + 1;
          tile.innerHTML = `<span class="ab">${esc(s.abbr)}</span><span class="tv">${mapMetric === "mw" ? (s.capacity_mw >= 1000 ? `${(s.capacity_mw / 1000).toFixed(0)}G` : `${Math.round(s.capacity_mw)}M`) : fmt(s.facilities)}</span>`;
          // §8: hover-only tooltip content mirrored for keyboard/SR users.
          tile.setAttribute("aria-label", `${langIndex() ? s.name_zh : s.name_en} · ${fmt(s.facilities)} ${L(I18N.facilities)} · ${fmtMW(s.capacity_mw)}`);
          tile.addEventListener("mousemove", ev => showTip(`<div class="t1">${esc(langIndex() ? s.name_zh : s.name_en)}</div><div class="t2">${fmt(s.facilities)} ${L(I18N.facilities)} · ${fmtMW(s.capacity_mw)}</div>`, ev));
          tile.addEventListener("mouseleave", hideTip);
          tile.addEventListener("click", () => {
            selState = selState === s.abbr ? null : s.abbr;
            buildMap();
            renderRealMap();
            syncStateFilter();
          });
          el.appendChild(tile);
        });

        const labels = mapMetric === "mw" ? I18N.legMW : I18N.legN;
        document.getElementById("mapLegend").innerHTML = labels.map((label, i) => `<div class="lg"><span class="sw b${i}"></span>${label}</div>`).join("");
        document.getElementById("mapNoteText").textContent = langIndex()
          ? "美国方块地图：每州等面积，颜色代表规模；点击州后，Leaflet 地图下钻显示该州县级亮点。"
          : "US tile cartogram: every state gets equal area and color carries magnitude; click a state to drill the Leaflet map into county highlights.";
      }

      function updateMapSide() {
        const items = !selCountry ? DATA.countries : selCountry === "US" && selState ? (countiesByState[selState] || []) : selCountry === "US" ? DATA.states : (selectedCountry()?.subnationals || []);
        const top = [...items].sort((a, b) => mapMetric === "mw" ? b.capacity_mw - a.capacity_mw : b.facilities - a.facilities)[0];
        if (!top) return;
        document.getElementById("mapTopV").textContent = mapMetric === "mw" ? fmtMW(top.capacity_mw) : fmt(top.facilities);
        const name = top.code ? countryName(top) : top.name ? top.name : langIndex() ? top.name_zh : top.name_en;
        document.getElementById("mapTopL").textContent = `${name} - ${mapMetric === "mw" ? L(I18N.largest) : L(I18N.mostFacilities)}`;
      }

      function updateFunnelTitle() {
        const funnel = scopedFunnel();
        const planned = funnel.find(f => f.key === "pla");
        const operational = funnel.find(f => f.key === "op");
        const prefix = selectedCountry() ? `${countryName(selectedCountry())}: ` : "";
        // §4.1: headline the planned-vs-live multiple — every stage that is
        // not yet operational, expressed as a multiple of what is live today.
        const notLiveMw = funnel.filter(f => f.key !== "op").reduce((sum, f) => sum + f.capacity_mw, 0);
        const multiple = operational.capacity_mw > 0 ? notLiveMw / operational.capacity_mw : null;
        const wave = multiple != null && isFinite(multiple) && multiple > 0
          ? (langIndex() ? ` — 还有 ${multiple.toFixed(1)}× 的浪潮待落地` : ` — a ${multiple.toFixed(1)}× wave still to land`)
          : "";
        document.getElementById("funnelTitle").innerHTML = langIndex()
          ? `${prefix}规划 ${fmtMW(planned.capacity_mw)} 对比在运 ${fmtMW(operational.capacity_mw)}${wave}`
          : `${prefix}${fmtMW(planned.capacity_mw)} planned vs ${fmtMW(operational.capacity_mw)} live${wave}`;
      }

      function buildFunnel() {
        const funnel = scopedFunnel();
        const max = Math.max(1, ...funnel.map(f => f.capacity_mw));
        const totalMw = funnel.reduce((sum, f) => sum + f.capacity_mw, 0);
        document.getElementById("funnel").innerHTML = funnel.map((f, i) => {
          // §4.1: print the stage-to-stage capacity ratio between bars.
          const prev = i > 0 ? funnel[i - 1] : null;
          const ratio = prev && prev.capacity_mw > 0 ? Math.round(f.capacity_mw / prev.capacity_mw * 100) : null;
          const ratioTitle = langIndex() ? "相对上一阶段的容量比" : "capacity vs previous stage";
          return `
          ${ratio == null ? "" : `<div class="fratio"><span title="${ratioTitle}">→ ${ratio}%</span></div>`}
          <div class="frow" data-fi="${i}">
            <div class="fl"><span class="fdot" style="background:${stColor(f.key)}"></span>${I18N.st[f.key][langIndex()]}</div>
            <div class="fbar"><i style="--w:${(f.capacity_mw / max * 100).toFixed(1)}%; background:${stColor(f.key)}"></i></div>
            <div class="fv"><b>${fmtMW(f.capacity_mw)}</b><span>${fmt(f.count)} ${L(I18N.projects)}</span></div>
          </div>`;
        }).join("");
        document.querySelectorAll("#funnel .frow").forEach(rowEl => {
          rowEl.addEventListener("mousemove", ev => {
            const f = funnel[Number(rowEl.dataset.fi)];
            const share = totalMw > 0 ? (f.capacity_mw / totalMw * 100).toFixed(1) : "0.0";
            showTip(`<div class="t1">${I18N.st[f.key][langIndex()]}</div><div class="t2">${fmtMW(f.capacity_mw)} · ${fmt(f.count)} ${L(I18N.projects)}<br>${langIndex() ? "占全部阶段容量" : "share of all stages"}: ${share}%</div>`, ev);
          });
          rowEl.addEventListener("mouseleave", hideTip);
        });
      }

      // Treemap color comes from the dominant capacity-bearing status in each
      // country funnel; subnational rows inherit that country phase because the
      // aggregate export does not include subnational funnel breakdowns.
      const TM_SIZE = 1000;
      const TM_PAD = 2;
      const TM_PHASES = ["op", "con", "app", "pla", "ann", "unk"];
      const tmColorKey = key => key === "rej" || key === "coverage" || !key ? "unk" : key;
      let tmCountryCode = null;
      let tmAnimFrom = null;

      function dominantStatus(funnel = []) {
        return (funnel || []).reduce((best, row) => {
          const mw = Number(row.capacity_mw) || 0;
          return mw > best.mw ? { key: row.key, mw } : best;
        }, { key: "unk", mw: -1 }).key;
      }

      function statusName(key) {
        const colorKey = tmColorKey(key);
        return I18N.st[colorKey]?.[langIndex()] || (langIndex() ? "未知" : "Unknown");
      }

      function tmLegendName(key) {
        if (key === "unk") return langIndex() ? "未知 / 否决 / 覆盖" : "Unknown / rejected / coverage";
        return statusName(key);
      }

      function tmGradientId(key) {
        return `tm-grad-${tmColorKey(key)}`;
      }

      function tmStrokeId(key) {
        return `tm-stroke-${tmColorKey(key)}`;
      }

      function tmGradientStyle(key) {
        const color = stColor(tmColorKey(key));
        return `linear-gradient(180deg, color-mix(in srgb, ${color} 72%, #fff 28%), ${color})`;
      }

      function tmDefs() {
        return `<defs>${TM_PHASES.map(key => {
          const color = stColor(key);
          return `<linearGradient id="${tmGradientId(key)}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" style="stop-color:color-mix(in srgb, ${color} 72%, #fff 28%)"></stop>
            <stop offset="100%" style="stop-color:${color}"></stop>
          </linearGradient>
          <linearGradient id="${tmStrokeId(key)}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" style="stop-color:color-mix(in srgb, ${color} 72%, #111 28%)"></stop>
            <stop offset="100%" style="stop-color:color-mix(in srgb, ${color} 58%, #000 42%)"></stop>
          </linearGradient>`;
        }).join("")}</defs>`;
      }

      function tmRows() {
        const country = tmCountryCode ? countryByCode.get(tmCountryCode) : null;
        if (!country) {
          return (DATA.countries || [])
            .filter(c => Number(c.capacity_mw) > 0)
            .map(c => ({
              id: c.code,
              label: c.code,
              title: `${c.name_en} / ${c.name_zh}`,
              value: Number(c.capacity_mw) || 0,
              facilities: Number(c.facilities) || 0,
              tracked_gw: gwOf(c, "tracked_mw", "tracked_gw"),
              est_gw: gwOf(c, "est_mw", "est_gw"),
              status: dominantStatus(c.funnel),
              funnel: c.funnel || [],
              country: c,
              drillable: (c.subnationals || []).length > 0,
            }));
        }
        const status = dominantStatus(country.funnel);
        return (country.subnationals || [])
          .filter(s => Number(s.capacity_mw) > 0)
          .map((s, i) => ({
            id: `${country.code}-${i}`,
            label: s.name,
            title: `${countryName(country)} / ${s.name}`,
            value: Number(s.capacity_mw) || 0,
            facilities: Number(s.facilities) || 0,
            tracked_gw: null,
            est_gw: null,
            status,
            funnel: country.funnel || [],
            country,
            drillable: false,
          }));
      }

      function worst(row, side) {
        if (!row.length) return Infinity;
        const sum = row.reduce((a, b) => a + b.area, 0);
        const max = Math.max(...row.map(d => d.area));
        const min = Math.min(...row.map(d => d.area));
        const s2 = side * side;
        return Math.max((s2 * max) / (sum * sum), (sum * sum) / (s2 * min));
      }

      function layoutRow(row, rect, out) {
        const sum = row.reduce((a, b) => a + b.area, 0);
        if (rect.w >= rect.h) {
          const h = sum / rect.w;
          let x = rect.x;
          row.forEach(item => {
            const w = item.area / h;
            out.push({ ...item, x, y: rect.y, w, h });
            x += w;
          });
          rect.y += h;
          rect.h -= h;
        } else {
          const w = sum / rect.h;
          let y = rect.y;
          row.forEach(item => {
            const h = item.area / w;
            out.push({ ...item, x: rect.x, y, w, h });
            y += h;
          });
          rect.x += w;
          rect.w -= w;
        }
      }

      function squarify(rows, width, height) {
        const total = rows.reduce((sum, d) => sum + d.value, 0) || 1;
        const items = rows
          .map(d => ({ ...d, area: d.value / total * width * height }))
          .sort((a, b) => b.area - a.area);
        const rect = { x: 0, y: 0, w: width, h: height };
        const out = [];
        let row = [];
        while (items.length) {
          const item = items[0];
          const side = Math.min(rect.w, rect.h);
          if (!row.length || worst([...row, item], side) <= worst(row, side)) {
            row.push(items.shift());
          } else {
            layoutRow(row, rect, out);
            row = [];
          }
        }
        if (row.length) layoutRow(row, rect, out);
        return out;
      }

      function tmBreakdown(funnel = []) {
        const total = funnel.reduce((sum, f) => sum + (Number(f.capacity_mw) || 0), 0) || 1;
        return (funnel || [])
          .filter(f => Number(f.capacity_mw) > 0)
          .sort((a, b) => (Number(b.capacity_mw) || 0) - (Number(a.capacity_mw) || 0))
          .map(f => `${statusName(f.key)} ${fmtMW(f.capacity_mw)} (${Math.round(Number(f.capacity_mw) / total * 100)}%)`)
          .join("<br>");
      }

      function tmTooltip(d, ev) {
        const tracked = d.tracked_gw == null ? "" : `<br>${langIndex() ? "已知 vs 估算" : "Tracked vs est"}: ${d.tracked_gw.toFixed(1)} GW / ${d.est_gw.toFixed(1)} GW`;
        const click = d.drillable ? `<br>${langIndex() ? "点击下钻地区" : "Click to drill into areas"}` : "";
        showTip(`<div class="t1">${esc(d.title)}</div><div class="t2">${fmtMW(d.value)}${tracked}<br>${fmt(d.facilities)} ${L(I18N.facilities)}<br>${langIndex() ? "主导阶段" : "Dominant phase"}: <b>${statusName(d.status)}</b><br>${tmBreakdown(d.funnel)}${click}</div>`, ev);
      }

      function buildTreemap() {
        const svg = document.getElementById("tmSvg");
        const country = tmCountryCode ? countryByCode.get(tmCountryCode) : null;
        const rows = tmRows();
        const totalMw = rows.reduce((sum, d) => sum + d.value, 0);
        const totalGw = totalMw / 1000;
        const unit = totalGw >= 1000 ? "TW" : "GW";
        const shown = unit === "TW" ? totalGw / 1000 : totalGw;
        document.getElementById("tmNum").textContent = shown.toFixed(shown >= 100 ? 0 : shown >= 10 ? 1 : 2);
        document.getElementById("tmUnit").textContent = unit;
        document.getElementById("tmScopeLabel").textContent = country
          ? (langIndex() ? "国内地区" : "SUBNATIONAL AREAS")
          : (langIndex() ? "全球国家" : "WORLD COUNTRIES");
        document.getElementById("tmSub").innerHTML = country
          ? `<span><i style="background:${stColor(tmColorKey(dominantStatus(country.funnel)))}"></i>${esc(countryName(country))}</span><span>${fmt(country.subnationals.length)} ${L(I18N.subnationalsWithProjects)}</span>`
          : `<span>${fmt(rows.length)} ${L(I18N.countriesWithProjects)}</span><span>${splitFull(DATA.totals.tracked_gw, DATA.totals.est_gw)}</span>`;
        document.getElementById("tmLegend").innerHTML = TM_PHASES.map(key => `<span><i class="sw" style="background:${tmGradientStyle(key)}"></i>${tmLegendName(key)}</span>`).join("");
        document.getElementById("tmBack").hidden = !country;
        document.getElementById("tmCrumb").textContent = country
          ? `${langIndex() ? "全球" : "World"} / ${countryName(country)}`
          : (langIndex() ? "全球 / 国家" : "World / countries");

        const fromRect = tmAnimFrom;
        tmAnimFrom = null;
        const layoutRows = squarify(rows, TM_SIZE, TM_SIZE).map(d => {
          const x = d.x + TM_PAD;
          const y = d.y + TM_PAD;
          const w = Math.max(0, d.w - TM_PAD * 2);
          const h = Math.max(0, d.h - TM_PAD * 2);
          const area = w * h;
          return { ...d, x, y, w, h, area };
        });
        const tiles = layoutRows.map(d => {
          const showName = d.w > 70 && d.h > 38 && d.area > 4200;
          const showValue = d.w > 92 && d.h > 64 && d.area > 8200;
          const label = d.label.length > 18 ? `${d.label.slice(0, 15)}...` : d.label;
          const labelSize = Math.max(10, Math.min(18, Math.min(d.w / Math.max(4, label.length * 0.62), d.h / 3.8)));
          const valueSize = Math.max(9, Math.min(12, labelSize * 0.72));
          const nameY = showValue ? d.h / 2 - labelSize * 0.45 : d.h / 2;
          const valueY = d.h / 2 + labelSize * 0.72;
          const title = esc(`${d.title} · ${fmtMW(d.value)} · ${statusName(d.status)}`);
          const scaleX = fromRect ? Math.max(0.001, fromRect.w / Math.max(1, d.w)) : 1;
          const scaleY = fromRect ? Math.max(0.001, fromRect.h / Math.max(1, d.h)) : 1;
          const initial = fromRect ? `translate(${fromRect.x.toFixed(2)}px, ${fromRect.y.toFixed(2)}px) scale(${scaleX.toFixed(4)}, ${scaleY.toFixed(4)})` : `translate(${d.x.toFixed(2)}px, ${d.y.toFixed(2)}px) scale(1, 1)`;
          return `<g class="tm-tile" data-id="${esc(d.id)}" data-enter="${fromRect ? "true" : "false"}" tabindex="0" role="${d.drillable ? "button" : "img"}" aria-label="${title}" style="transform:${initial}">
            <title>${title}</title>
            <rect width="${d.w.toFixed(2)}" height="${d.h.toFixed(2)}" rx="4" ry="4" style="fill:url(#${tmGradientId(d.status)}); stroke:url(#${tmStrokeId(d.status)}); stroke-width:1"></rect>
            ${showName ? `<text class="tm-label" x="${(d.w / 2).toFixed(2)}" y="${nameY.toFixed(2)}" font-size="${labelSize.toFixed(1)}">${esc(label)}</text>` : ""}
            ${showValue ? `<text class="tm-value" x="${(d.w / 2).toFixed(2)}" y="${valueY.toFixed(2)}" font-size="${valueSize.toFixed(1)}">${fmtMW(d.value)}</text>` : ""}
          </g>`;
        }).join("");
        svg.innerHTML = `${tmDefs()}${tiles}`;
        if (fromRect && !noMotion) {
          requestAnimationFrame(() => {
            svg.querySelectorAll(".tm-tile").forEach(tile => {
              const row = layoutRows.find(r => r.id === tile.dataset.id);
              if (!row) return;
              tile.style.transform = `translate(${row.x.toFixed(2)}px, ${row.y.toFixed(2)}px) scale(1, 1)`;
              tile.dataset.enter = "false";
            });
          });
        } else {
          svg.querySelectorAll(".tm-tile").forEach(tile => {
            const row = layoutRows.find(r => r.id === tile.dataset.id);
            if (row) tile.style.transform = `translate(${row.x.toFixed(2)}px, ${row.y.toFixed(2)}px) scale(1, 1)`;
            tile.dataset.enter = "false";
          });
        }
        svg.querySelectorAll(".tm-tile").forEach((tile, i) => {
          const row = layoutRows.find(r => r.id === tile.dataset.id);
          if (!row) return;
          tile.addEventListener("mousemove", ev => tmTooltip(row, ev));
          tile.addEventListener("mouseleave", hideTip);
          tile.addEventListener("click", () => {
            if (!row.drillable) return;
            tmAnimFrom = row;
            tmCountryCode = row.country.code;
            hideTip();
            buildTreemap();
          });
          tile.addEventListener("keydown", e => {
            if ((e.key === "Enter" || e.key === " ") && row.drillable) {
              e.preventDefault();
              tmAnimFrom = row;
              tmCountryCode = row.country.code;
              hideTip();
              buildTreemap();
            }
          });
        });
      }

      function setDevTab(tab) {
        devTab = tab;
        document.getElementById("dv-mw").classList.toggle("on", tab === "mw");
        document.getElementById("dv-n").classList.toggle("on", tab === "n");
        buildDevs();
      }

      function buildDevs() {
        const rows = DATA.developers[devTab];
        const max = Math.max(...rows.map(r => devTab === "mw" ? r.capacity_mw : r.facilities));
        document.getElementById("devs").innerHTML = rows.map((r, i) => {
          const value = devTab === "mw" ? r.capacity_mw : r.facilities;
          const detail = devTab === "mw"
            ? `${fmtMW(r.capacity_mw)} · ${fmt(r.facilities)} ${langIndex() ? "个站点" : r.facilities === 1 ? "site" : "sites"}`
            : `${fmt(r.facilities)} ${langIndex() ? "个站点" : "sites"} · ${fmtMW(r.capacity_mw)}`;
          // §4.4: rows navigate to the registry scoped to that operator; the
          // "Unknown operator" bucket is an aggregate, not a searchable name.
          const clickable = !/^unknown operator$/i.test(r.name);
          const nav = clickable ? ` role="button" tabindex="0" data-dev-scope="${esc(r.name)}" title="${esc(L(I18N.dc.devScope))}"` : "";
          return `<div class="drow${clickable ? " clk" : ""}"${nav}>
            <div class="rk">${String(i + 1).padStart(2, "0")}</div>
            <div class="dn" title="${esc(r.name)}">${esc(r.name)}</div>
            <div class="dbar"><i style="--w:${(value / max * 100).toFixed(1)}%; --d:${i * 0.06}s"></i></div>
            <div class="dv">${detail}</div>
          </div>`;
        }).join("");
        document.getElementById("devs").classList.add("in");
      }

      // Scoped operators (plan §4.4): an operator name anywhere — leaderboard
      // row or detail modal — pivots the registry to that developer across
      // all countries: clear the country scope, set the search box, jump down.
      function scopeToOperator(name) {
        if (!name) return;
        closeDcModal();
        loadCorpus();
        document.getElementById("fSearch").value = name;
        if (selCountry) setCountry(selCountry);
        else renderTable();
        document.getElementById("fSearch").scrollIntoView({ block: "center", behavior: noMotion ? "auto" : "smooth" });
      }

      function buildFilters() {
        document.getElementById("fSearch").placeholder = L(I18N.searchPh);
        const fs = document.getElementById("fStatus");
        const keepStatus = fs.value;
        fs.innerHTML = `<option value="">${L(I18N.all)}</option>` + ["ann", "pla", "app", "con", "op"].map(k => `<option value="${k}">${I18N.st[k][langIndex()]}</option>`).join("");
        fs.value = keepStatus || "";

        const stateSelect = document.getElementById("fState");
        const keepState = stateSelect.value;
        const scoped = DATA.centers.filter(c => !selCountry || c.country === selCountry);
        const key = selCountry && selCountry !== "US" ? "subnational" : "state";
        const states = [...new Set(scoped.map(c => c[key]).filter(Boolean))].sort();
        stateSelect.innerHTML = `<option value="">${selCountry && selCountry !== "US" ? L(I18N.allSubnational) : L(I18N.allStates)}</option>` + states.map(a => `<option>${esc(a)}</option>`).join("");
        stateSelect.value = states.includes(keepState) ? keepState : "";
        // URL geo drill (plan §3.3): the value from the hash may only exist
        // in the lazy corpus, so it stays pending until an option matches.
        if (urlGeoPending && states.includes(urlGeoPending)) {
          stateSelect.value = urlGeoPending;
          if (selCountry === "US") selState = urlGeoPending;
          urlGeoPending = "";
        }
      }

      function syncStateFilter() {
        document.getElementById("fState").value = selState || "";
        renderTable();
        // Stay in place on the map when drilling into a state/county (Jason 3570).
        // No scrollIntoView here: the detail table updates in place; the user keeps the map viewport.
      }

      function clearStateFilter() {
        selState = null;
        document.getElementById("fState").value = "";
        buildMap();
        renderRealMap();
        renderTable();
      }

      function setSort(key) {
        if (sortKey === key) sortDir *= -1;
        else {
          sortKey = key;
          sortDir = -1;
        }
        renderTable();
      }

      // Registry virtualization (plan §3.1): currentRows keeps the full
      // filtered+sorted list in memory; the DOM only ever holds the rows
      // inside the .tblwrap viewport plus OVERSCAN on each side, framed by
      // two spacer rows that stand in for the off-screen scroll height.
      let ROW_H = 57;
      const OVERSCAN = 8;
      let vFirst = -1;
      let vCount = -1;
      let vMaxMW = 1;
      let vMeasured = false;
      const tblScroller = document.querySelector(".tblwrap");
      const tbodyEl = document.getElementById("tbody");

      const countrySearchNames = new Map((DATA.countries || []).map(c => [c.code, `${c.code} ${c.name_en} ${c.name_zh}`.toLowerCase()]));
      const rowHaystack = c => c._q ||= [c.project, c.developer, c.county, c.subnational, c.state, countrySearchNames.get(c.country) || c.country]
        .filter(Boolean).join(" ").toLowerCase();

      function rowHTML(c, i) {
        return `
          <tr class="vrow" data-i="${i}" data-slug="${esc(c.slug || "")}" tabindex="0" style="cursor:pointer">
            <td class="proj"><b>${esc(c.project)}${c.est ? ` <span class="estbadge" title="${L(I18N.dc.estTitle)}">${L(I18N.dc.estBadge)}</span>` : ""}</b><span class="own">${esc(c.developer)}</span></td>
            <td class="geo">${esc(c.county)}, ${esc(c.subnational || c.state)} · ${esc(c.country)}</td>
            <td class="cap"><span class="capv">${fmtMW(c.capacity_mw)}</span><span class="capbar"><i style="width:${Math.max(1.2, c.capacity_mw / vMaxMW * 100).toFixed(1)}%"></i></span></td>
            <td><span class="chip" style="color:${stColor(c.status)}; border-color:${stColor(c.status)}; background:color-mix(in srgb, ${stColor(c.status)} 12%, transparent)"><span class="cdot"></span>${I18N.st[c.status][langIndex()]}</span></td>
            <td class="yr">${c.year || "-"}</td>
            <td class="gr">${esc(c.evidence)}</td>
          </tr>`;
      }

      function renderWindow() {
        const total = currentRows.length;
        if (!total) {
          vFirst = 0;
          vCount = 0;
          tbodyEl.innerHTML = `<tr class="vpad"><td colspan="6" style="padding:22px 10px; color:var(--mut); text-align:center; font:12px var(--mono)">${L(I18N.noMatch)}</td></tr>`;
          return;
        }
        const viewH = Math.max(tblScroller.clientHeight || 0, 480);
        const first = Math.max(0, Math.floor(tblScroller.scrollTop / ROW_H) - OVERSCAN);
        const count = Math.min(total - first, Math.ceil(viewH / ROW_H) + OVERSCAN * 2);
        if (first === vFirst && count === vCount) return;
        vFirst = first;
        vCount = count;
        const pad = h => h > 0.5 ? `<tr class="vpad" aria-hidden="true"><td colspan="6" style="height:${h}px"></td></tr>` : "";
        tbodyEl.innerHTML =
          pad(first * ROW_H) +
          currentRows.slice(first, first + count).map((c, k) => rowHTML(c, first + k)).join("") +
          pad((total - first - count) * ROW_H);
        if (!vMeasured) {
          // The CSS pins rows at 57px, but collapsed borders can round the
          // real height; adopt the measured value so spacer math stays exact.
          const probe = tbodyEl.querySelector("tr.vrow");
          const h = probe ? probe.getBoundingClientRect().height : 0;
          if (h > 20) {
            vMeasured = true;
            if (Math.abs(h - ROW_H) > 0.5) {
              ROW_H = h;
              vFirst = -1;
              renderWindow();
            }
          }
        }
      }

      let vTick = false;
      tblScroller.addEventListener("scroll", () => {
        if (vTick) return;
        vTick = true;
        requestAnimationFrame(() => {
          vTick = false;
          renderWindow();
        });
      });
      addEventListener("resize", () => {
        // §7.3: crossing the 680px card breakpoint changes the row height;
        // drop the cached measurement so the spacer math re-syncs.
        vMeasured = false;
        vFirst = -1;
        renderWindow();
      });

      function renderTable() {
        const status = document.getElementById("fStatus").value;
        const state = document.getElementById("fState").value;
        const q = document.getElementById("fSearch").value.trim().toLowerCase();
        if (selCountry === "US" && state !== (selState || "")) {
          selState = state || null;
          buildMap();
          renderRealMap();
        }
        const geoKey = selCountry && selCountry !== "US" ? "subnational" : "state";
        const scopedCenters = DATA.centers.filter(c => !selCountry || c.country === selCountry);
        vMaxMW = Math.max(1, ...scopedCenters.map(c => c.capacity_mw));
        let rows = scopedCenters.filter(c => (!status || c.status === status) && (!state || c[geoKey] === state) && (!q || rowHaystack(c).includes(q)));
        rows.sort((a, b) => {
          if (sortKey === "mw") return (a.capacity_mw - b.capacity_mw) * sortDir;
          if (sortKey === "y") return ((a.year || 0) - (b.year || 0)) * sortDir;
          return `${a.country}${a[geoKey]}${a.county}`.localeCompare(`${b.country}${b[geoKey]}${b.county}`) * sortDir;
        });
        currentRows = rows;
        tblScroller.scrollTop = 0;
        vFirst = -1;
        renderWindow();

        document.getElementById("fCount").textContent = `${L(I18N.showing)} ${fmt(rows.length)} ${L(I18N.of)} ${fmt(scopedCenters.length)} ${L(I18N.records)}`;
        const chip = document.getElementById("fClear");
        const stateFilter = selCountry === "US" ? selState : (selCountry ? state : "");
        chip.style.display = stateFilter ? "" : "none";
        chip.textContent = stateFilter ? `${stateFilter} x` : "";
        if (stateFilter) chip.setAttribute("aria-label", `${langIndex() ? "清除地区筛选" : "Clear area filter"}: ${stateFilter}`);
        const searchChip = document.getElementById("fSearchClear");
        searchChip.style.display = q ? "" : "none";
        searchChip.textContent = q ? `✕ ${L(I18N.searchClear)}` : "";
        ["mw", "y", "geo"].forEach(k => {
          document.getElementById(`car-${k}`).textContent = sortKey === k ? (sortDir < 0 ? "▼" : "▲") : "";
        });
        document.querySelectorAll("th.sortable").forEach(th => {
          th.setAttribute("aria-sort", th.dataset.sort === sortKey ? (sortDir < 0 ? "descending" : "ascending") : "none");
        });
        // Every filter path (status/state/search/scope drill) funnels through
        // here, so this one hook keeps the hash current (plan §3.3).
        syncUrl();
      }

      // §8: both dialogs trap Tab, focus their first control on open and
      // hand focus back to the opener on close.
      let dcReturnFocus = null;
      function closeDcModal() {
        const modal = document.getElementById("dcModal");
        if (modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = "";
        if (dcReturnFocus && document.contains(dcReturnFocus)) dcReturnFocus.focus();
        dcReturnFocus = null;
      }

      const dcMetaCache = new Map();
      let dcModalSlug = null;

      function openDcDetail(slug, row) {
        dcModalSlug = slug || null;
        if (!slug) {
          renderDcModal(null, row, "", false);
          return;
        }
        if (dcMetaCache.has(slug)) {
          renderDcModal(dcMetaCache.get(slug), row, slug, false);
          return;
        }
        // Detail metadata lives in per-slug files (plan §6.1): open instantly
        // on the registry row fields, swap in the full record when it lands.
        renderDcModal(null, row, slug, true);
        fetch(`${BASE}dc/${encodeURIComponent(slug)}.json`)
          .then(r => r.ok ? r.json() : null)
          .catch(() => null)
          .then(meta => {
            dcMetaCache.set(slug, meta);
            if (!document.getElementById("dcModal").hidden && dcModalSlug === slug) {
              renderDcModal(meta, row, slug, false);
            }
          });
      }

      function renderDcModal(meta, row, slug, loading) {
        const fallback = !meta;
        const title = meta && meta.canonical_project ? meta.canonical_project : (row ? row.project : slug || "—");
        const capacity = (meta && meta.capacity_mw != null) ? meta.capacity_mw : (row ? row.capacity_mw : null);
        const status = ((meta && meta.status) || (row ? row.status : "") || "");
        const location = meta && meta.location
          ? [meta.location.city, meta.location.subnational, meta.location.country].filter(Boolean).join(", ")
          : row
            ? [row.county, row.subnational || row.state, row.country].filter(Boolean).join(", ")
            : "";
        const evidence = row ? row.evidence : "";
        const sources = meta && Array.isArray(meta.sources) ? meta.sources : [];
        const note = meta && meta.notes ? meta.notes : "";
        const part = (dt, dd) => (dd === "" || dd == null) ? "" : `<dt>${dt}</dt><dd>${dd}</dd>`;

        const items = [];
        if (loading) items.push(`<div class="dc-note dc-loading">${L(I18N.dc.loading)}</div>`);
        else if (fallback) items.push(`<div class="dc-note">${L(I18N.dc.noDetail)}</div>`);
        items.push(part(L(I18N.dc.capacity), capacity != null ? fmtMW(capacity) : "—"));
        items.push(part(L(I18N.dc.status), status ? statusLabel(status) : "—"));
        if (meta && meta.owner) items.push(part(L(I18N.dc.owner), esc(meta.owner)));
        // §4.4: the developer name is a scoped view — click filters the
        // registry to that operator worldwide.
        if (row && row.developer) items.push(part(L(I18N.dc.developer), `<button type="button" class="dc-devlink" data-dev-scope="${esc(row.developer)}" title="${esc(L(I18N.dc.devScope))}">${esc(row.developer)}</button>`));
        items.push(part(L(I18N.dc.location), location ? esc(location) : "—"));
        if (meta && meta.evidence_grade) items.push(part(L(I18N.dc.evidenceGrade), esc(meta.evidence_grade)));
        if (meta && meta.evidence_date) items.push(part(L(I18N.dc.evidenceDate), esc(meta.evidence_date)));
        if (evidence) items.push(part(L(I18N.dc.evidence), I18N.ev[evidence] ? I18N.ev[evidence][langIndex()] : esc(evidence)));
        if (sources.length) items.push(part(L(I18N.dc.sources), sources.map(u => `<a href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(u)}</a>`).join("<br>")));
        if (note) items.push(part(L(I18N.dc.notes), esc(note).replace(/\n/g, "<br>")));

        const modal = document.getElementById("dcModal");
        const wasHidden = modal.hidden;
        document.getElementById("dcModalTitle").innerHTML =
          `${esc(title)}${row && row.est ? ` <span class="estbadge" title="${L(I18N.dc.estTitle)}">${L(I18N.dc.estBadge)}</span>` : ""}`;
        document.getElementById("dcModalSub").textContent = slug ? esc(slug) : "";
        document.getElementById("dcModalBody").innerHTML = items.join("");
        modal.hidden = false;
        document.body.style.overflow = "hidden";
        modal.querySelector(".dc-modal-box").scrollTop = 0;
        if (wasHidden) {
          dcReturnFocus = document.activeElement;
          modal.querySelector(".dc-modal-close").focus();
        }
      }

      function buildEvidence() {
        const total = DATA.evidence.reduce((sum, e) => sum + e.count, 0);
        const colors = ["var(--ev0)", "var(--ev1)", "var(--ev2)", "var(--ev3)"];
        document.getElementById("evbar").innerHTML = DATA.evidence.map((e, i) => `<i style="width:${(e.count / total * 100).toFixed(1)}%; background:${colors[i]}; --d:${i * 0.12}s"></i>`).join("");
        document.getElementById("evkey").innerHTML = DATA.evidence.map((e, i) => `<div class="lg"><span class="sw" style="background:${colors[i]}"></span>${I18N.ev[e.key][langIndex()]} · <b>${fmt(e.count)}</b> (${(e.count / total * 100).toFixed(0)}%)</div>`).join("");
      }

      // Signal ticker (plan §2.4): headline aggregates, top-5 countries and
      // the largest flagship rows, all from the inline payload — no fetch.
      // DATA.flagship (not DATA.centers) keeps the strip stable when the
      // lazy corpus swaps in. Rebuilt on language change; duration scales
      // with content width so the pace stays constant in both languages.
      function buildTicker() {
        const tickerEl = document.getElementById("ticker");
        if (noMotion) {
          tickerEl.hidden = true;
          return;
        }
        const zh = langIndex() === 1;
        const t = DATA.totals;
        const gw = Number(t.capacity_gw) || 0;
        const items = [];
        const item = (k, v, cls) => items.push(`<span class="gw-ti"><span class="tk">${k}</span><b${cls ? ` class="${cls}"` : ""}>${v}</b></span>`);
        item(zh ? "追踪容量" : "TRACKED CAPACITY", gw >= 1000 ? `${(gw / 1000).toFixed(2)} TW` : `${gw.toFixed(1)} GW`, "tmark");
        item(zh ? "设施" : "FACILITIES", fmt(t.facilities));
        item(zh ? "国家与地区" : "COUNTRIES & TERRITORIES", fmt(t.countries_with_projects));
        item(zh ? "数据来源" : "SOURCE URLS", fmt(t.sources));
        [...(DATA.countries || [])].sort((a, b) => b.capacity_mw - a.capacity_mw).slice(0, 5).forEach((c, i) => {
          item(`#${i + 1} ${esc(c.code)}`, `${esc(countryName(c))} · ${fmtMW(c.capacity_mw)}`);
        });
        [...(DATA.flagship || [])].sort((a, b) => b.capacity_mw - a.capacity_mw).slice(0, 8).forEach(c => {
          const loc = [c.county, c.state || c.subnational, c.country].filter(Boolean).join(" ");
          items.push(`<span class="gw-ti"><span class="tup">▲</span><b>${esc(loc)}</b><span>${fmtMW(c.capacity_mw)} · ${statusLabel(c.status)}</span></span>`);
        });
        const copy = `<div class="gw-ticker-copy">${items.join("")}</div>`;
        const track = document.getElementById("tickerTrack");
        track.innerHTML = copy + copy;
        requestAnimationFrame(() => {
          const width = track.scrollWidth / 2;
          if (width > 0) tickerEl.style.setProperty("--tick-dur", `${Math.max(30, Math.round(width / 42))}s`);
          tickerEl.classList.add("roll");
        });
      }

      // Command palette (plan §3.2): ⌘K / Ctrl+K jumps to any country or
      // facility in two keystrokes. Facility search reuses the registry
      // haystacks (§3.1) over the lazy corpus, so opening the palette also
      // kicks off loadCorpus(); until it lands, only flagship rows match.
      const cmdkEl = document.getElementById("cmdk");
      const cmdkInput = document.getElementById("cmdkInput");
      const cmdkListEl = document.getElementById("cmdkList");
      let cmdkResults = [];
      let cmdkActive = 0;
      function cmdkSearch(raw) {
        const query = raw.trim().toLowerCase();
        const countries = [...(DATA.countries || [])]
          .sort((a, b) => b.capacity_mw - a.capacity_mw)
          .filter(c => !query || (countrySearchNames.get(c.code) || "").includes(query))
          .slice(0, query ? 6 : 10)
          .map(c => ({ kind: "country", c }));
        const facilities = !query ? [] : DATA.centers
          .filter(c => rowHaystack(c).includes(query))
          .sort((a, b) => b.capacity_mw - a.capacity_mw)
          .slice(0, 12)
          .map(c => ({ kind: "facility", c }));
        return [...countries, ...facilities];
      }
      function cmdkRender() {
        if (!cmdkResults.length) {
          cmdkListEl.innerHTML = `<div class="cmdk-empty">${L(I18N.noMatch)}</div>`;
          return;
        }
        cmdkListEl.innerHTML = cmdkResults.map((r, i) => {
          const act = i === cmdkActive ? " act" : "";
          if (r.kind === "country") {
            return `<button type="button" class="cmdk-row${act}" role="option" data-ck="${i}">
              <span class="ck">${langIndex() ? "国家" : "SCOPE"}</span>
              <span class="cn">${esc(r.c.code)} · ${esc(countryName(r.c))}</span>
              <span class="cv">${gwOf(r.c, "capacity_mw", "capacity_gw").toFixed(1)} GW</span></button>`;
          }
          const loc = [r.c.county, r.c.subnational || r.c.state, r.c.country].filter(Boolean).join(", ");
          return `<button type="button" class="cmdk-row${act}" role="option" data-ck="${i}">
            <span class="ck">${langIndex() ? "设施" : "SITE"}</span>
            <span class="cn">${esc(r.c.project)} <small>· ${esc(loc)}</small></span>
            <span class="cv">${fmtMW(r.c.capacity_mw)}</span></button>`;
        }).join("");
        const actEl = cmdkListEl.querySelector(".cmdk-row.act");
        if (actEl) actEl.scrollIntoView({ block: "nearest" });
      }
      function cmdkUpdate() {
        cmdkResults = cmdkSearch(cmdkInput.value);
        cmdkActive = 0;
        cmdkRender();
      }
      let cmdkReturnFocus = null;
      function openCmdk() {
        loadCorpus();
        cmdkReturnFocus = document.activeElement;
        cmdkEl.hidden = false;
        document.body.style.overflow = "hidden";
        cmdkInput.value = "";
        cmdkInput.placeholder = langIndex() ? "跳转到国家或设施…" : "JUMP TO COUNTRY OR FACILITY…";
        cmdkUpdate();
        cmdkInput.focus();
      }
      function closeCmdk() {
        cmdkEl.hidden = true;
        document.body.style.overflow = "";
        if (cmdkReturnFocus && document.contains(cmdkReturnFocus)) cmdkReturnFocus.focus();
        cmdkReturnFocus = null;
      }
      function cmdkPick(i) {
        const r = cmdkResults[i];
        if (!r) return;
        closeCmdk();
        if (r.kind === "country") {
          if (selCountry !== r.c.code) setCountry(r.c.code);
          document.getElementById("realMap").scrollIntoView({ block: "center", behavior: noMotion ? "auto" : "smooth" });
        } else {
          openDcDetail(r.c.slug || "", r.c);
        }
      }
      cmdkInput.addEventListener("input", cmdkUpdate);
      cmdkInput.addEventListener("keydown", e => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          if (!cmdkResults.length) return;
          cmdkActive = (cmdkActive + (e.key === "ArrowDown" ? 1 : cmdkResults.length - 1)) % cmdkResults.length;
          cmdkRender();
        } else if (e.key === "Enter") {
          e.preventDefault();
          cmdkPick(cmdkActive);
        }
      });
      cmdkListEl.addEventListener("click", e => {
        const row = e.target.closest("[data-ck]");
        if (row) cmdkPick(Number(row.dataset.ck));
      });
      document.addEventListener("click", e => {
        if (e.target.closest("[data-cmdk-close]")) closeCmdk();
        if (e.target.closest("[data-cmdk-open]")) openCmdk();
      });

      document.getElementById("dotToggle").addEventListener("click", () => {
        dotsEnabled = !dotsEnabled;
        syncDotToggle();
        updateFacilityDots();
        // Enabling below the zoom gate would show nothing; nudge the map in.
        if (dotsEnabled && realMap && realMap.getZoom() < DOT_MIN_ZOOM) {
          realMap.flyTo(realMap.getCenter(), DOT_MIN_ZOOM, { animate: !noMotion });
        }
      });

      document.querySelectorAll("[data-theme-button]").forEach(button => button.addEventListener("click", () => setTheme(button.dataset.themeButton)));
      document.querySelectorAll("[data-lang-button]").forEach(button => button.addEventListener("click", () => setLang(button.dataset.langButton)));
      document.querySelectorAll("[data-map-metric]").forEach(button => button.addEventListener("click", () => setMapMetric(button.dataset.mapMetric)));
      document.querySelectorAll("[data-dev-tab]").forEach(button => button.addEventListener("click", () => setDevTab(button.dataset.devTab)));
      document.getElementById("tmBack").addEventListener("click", () => {
        tmAnimFrom = { x: TM_PAD, y: TM_PAD, w: TM_SIZE - TM_PAD * 2, h: TM_SIZE - TM_PAD * 2 };
        tmCountryCode = null;
        hideTip();
        buildTreemap();
      });
      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && tmCountryCode && document.getElementById("cmdk").hidden) {
          tmAnimFrom = { x: TM_PAD, y: TM_PAD, w: TM_SIZE - TM_PAD * 2, h: TM_SIZE - TM_PAD * 2 };
          tmCountryCode = null;
          hideTip();
          buildTreemap();
        }
      });
      document.querySelectorAll("[data-sort]").forEach(th => {
        th.addEventListener("click", () => setSort(th.dataset.sort));
        th.addEventListener("keydown", e => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            setSort(th.dataset.sort);
          }
        });
      });
      document.getElementById("fStatus").addEventListener("change", renderTable);
      document.getElementById("fState").addEventListener("change", renderTable);
      const fSearchEl = document.getElementById("fSearch");
      fSearchEl.addEventListener("input", () => {
        loadCorpus();
        renderTable();
      });
      document.getElementById("fSearchClear").addEventListener("click", () => {
        fSearchEl.value = "";
        renderTable();
        fSearchEl.focus();
      });
      const mapFullBtn = document.getElementById("mapFull");
      const mapWrapEl = document.querySelector(".realmap-wrap");
      function syncMapFullLabel() {
        mapFullBtn.textContent = document.fullscreenElement ? "✕" : "⛶";
        mapFullBtn.classList.toggle("on", Boolean(document.fullscreenElement));
      }
      mapFullBtn.addEventListener("click", () => {
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        } else if (mapWrapEl.requestFullscreen) {
          mapWrapEl.requestFullscreen().catch(() => {});
        }
      });
      document.addEventListener("fullscreenchange", () => {
        syncMapFullLabel();
        if (realMap) setTimeout(() => realMap.invalidateSize(), 50);
        // §7.4: fullscreen has no page scroll to protect — one finger pans.
        if (coarsePointer && realMap) {
          if (document.fullscreenElement) realMap.dragging.enable();
          else realMap.dragging.disable();
          if (mapTouchHint) mapTouchHint.classList.remove("show");
        }
      });
      syncMapFullLabel();
      document.getElementById("fClear").addEventListener("click", clearStateFilter);
      document.getElementById("tbody").addEventListener("click", e => {
        const tr = e.target.closest("tr[data-slug]");
        if (!tr) return;
        const slug = tr.dataset.slug || "";
        const idx = Number(tr.dataset.i);
        openDcDetail(slug, slug ? (rowBySlug.get(slug) || null) : (currentRows[idx] || null));
      });
      // §8: rows are focusable (tabindex in rowHTML); Enter/Space opens the
      // same detail modal as a click.
      document.getElementById("tbody").addEventListener("keydown", e => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const tr = e.target.closest("tr[data-slug]");
        if (!tr) return;
        e.preventDefault();
        const slug = tr.dataset.slug || "";
        openDcDetail(slug, slug ? (rowBySlug.get(slug) || null) : (currentRows[Number(tr.dataset.i)] || null));
      });
      // §7.5: emulated mouse events pin the tooltip on tap; a tap anywhere
      // outside a chart element dismisses it.
      if (coarsePointer) {
        document.addEventListener("touchstart", e => {
          if (!e.target.closest(".frow, .tile, .tm-tile")) hideTip();
        }, { passive: true });
      }
      document.addEventListener("click", e => {
        if (e.target.closest("[data-dc-close]")) closeDcModal();
        const dev = e.target.closest("[data-dev-scope]");
        if (dev) scopeToOperator(dev.dataset.devScope);
      });
      document.getElementById("devs").addEventListener("keydown", e => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const dev = e.target.closest("[data-dev-scope]");
        if (dev) {
          e.preventDefault();
          scopeToOperator(dev.dataset.devScope);
        }
      });
      document.addEventListener("keydown", e => {
        if ((e.metaKey || e.ctrlKey) && !e.altKey && (e.key === "k" || e.key === "K")) {
          e.preventDefault();
          if (cmdkEl.hidden) openCmdk();
          else closeCmdk();
          return;
        }
        if (e.key === "Escape") {
          if (!cmdkEl.hidden) closeCmdk();
          else closeDcModal();
          return;
        }
        // §8: while a dialog is open, Tab cycles inside it.
        if (e.key === "Tab") {
          const box = !cmdkEl.hidden
            ? cmdkEl.querySelector(".cmdk-box")
            : !document.getElementById("dcModal").hidden
              ? document.getElementById("dcModalBox")
              : null;
          if (!box) return;
          const items = [...box.querySelectorAll('a[href], button:not([disabled]), input, select, [tabindex]:not([tabindex="-1"])')]
            .filter(el => el.offsetWidth || el.offsetHeight);
          if (!items.length) {
            e.preventDefault();
            return;
          }
          const first = items[0];
          const last = items[items.length - 1];
          if (!box.contains(document.activeElement)) {
            e.preventDefault();
            first.focus();
          } else if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Shareable URL state (plan §3.3): country / geo drill / map metric /
      // status / search serialize into the hash (#c=BR&m=n) —
      // parsed here before the first render below, replace-written on
      // filter changes, push-written on scope changes so back/forward
      // walks the scope history (popstate re-applies).
      const fStatusEl = document.getElementById("fStatus");
      const fStateEl = document.getElementById("fState");
      let applyingUrl = false;
      let urlGeoPending = "";
      const URL_STATUSES = ["ann", "pla", "app", "con", "op"];
      function parseUrlState() {
        const p = new URLSearchParams(location.hash.replace(/^#/, ""));
        const code = (p.get("c") || "").toUpperCase();
        return {
          c: countryByCode.has(code) ? code : null,
          s: p.get("s") || "",
          m: p.get("m") === "n" ? "n" : "mw",
          st: URL_STATUSES.includes(p.get("st")) ? p.get("st") : "",
          q: p.get("q") || "",
        };
      }
      function urlStateHash() {
        const p = new URLSearchParams();
        if (selCountry) p.set("c", selCountry);
        const geo = urlGeoPending || (selCountry === "US" ? (selState || "") : fStateEl.value);
        if (geo) p.set("s", geo);
        if (mapMetric !== "mw") p.set("m", mapMetric);
        if (fStatusEl.value) p.set("st", fStatusEl.value);
        const q = fSearchEl.value.trim();
        if (q) p.set("q", q);
        const s = p.toString();
        return s ? `#${s}` : "";
      }
      function syncUrl(push) {
        if (applyingUrl) return;
        const hash = urlStateHash();
        if (hash === location.hash) return;
        try {
          history[push ? "pushState" : "replaceState"](null, "", location.pathname + location.search + hash);
        } catch (error) {}
      }
      function setSelectValue(select, value) {
        if (value && ![...select.options].some(o => o.value === value)) {
          const option = document.createElement("option");
          option.value = option.textContent = value;
          select.appendChild(option);
        }
        select.value = value || "";
      }
      function syncMetricTabs() {
        document.getElementById("mm-mw").classList.toggle("on", mapMetric === "mw");
        document.getElementById("mm-n").classList.toggle("on", mapMetric === "n");
      }
      {
        const u = parseUrlState();
        selCountry = u.c;
        selState = u.c === "US" && u.s ? u.s : null;
        mapMetric = u.m;
        syncMetricTabs();
        urlGeoPending = u.s;
        setSelectValue(fStatusEl, u.st);
        fSearchEl.value = u.q;
        if (u.q || u.s) loadCorpus();
      }
      fStateEl.addEventListener("change", () => {
        urlGeoPending = "";
      });
      addEventListener("popstate", () => {
        const u = parseUrlState();
        applyingUrl = true;
        urlGeoPending = "";
        selCountry = u.c;
        selState = u.c === "US" && u.s ? u.s : null;
        mapMetric = u.m;
        syncMetricTabs();
        buildCountrySwitch();
        updateHero();
        buildFilters();
        setSelectValue(fStatusEl, u.st);
        setSelectValue(fStateEl, u.s);
        fSearchEl.value = u.q;
        if (u.q || u.s) loadCorpus();
        buildMap();
        renderRealMap();
        buildFunnel();
        buildTreemap();
        renderTable();
        updateMapSide();
        updateFunnelTitle();
        applyingUrl = false;
      });

      try {
        const theme = qs.get("theme") || localStorage.getItem("gw-theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        const language = qs.get("lang") || localStorage.getItem("gw-lang") || "en";
        setTheme(theme === "light" ? "light" : "dark");
        setLang(language === "zh" ? "zh" : "en");
      } catch (error) {
        setTheme("dark");
        setLang("en");
      }

      // Deferred corpus (plan §6.2): pull the heavy registry once the first
      // paint has settled; registry interactions retry a failed load.
      if ("requestIdleCallback" in window) requestIdleCallback(() => loadCorpus(), { timeout: 2500 });
      else setTimeout(loadCorpus, 900);
      document.getElementById("fStatus").addEventListener("change", loadCorpus);
      document.getElementById("fState").addEventListener("change", loadCorpus);

      countUp(document.getElementById("cFac"), DATA.totals.facilities, 0, 1500);
      countUp(document.getElementById("cSrc"), DATA.totals.sources, 0, 1700);
      countUp(document.getElementById("cCty"), DATA.totals.counties_with_projects, 0, 1600);

      buildFunnel();
      buildTreemap();
      buildMap();
      renderRealMap();
      buildFilters();
      renderTable();
      buildDevs();
      buildEvidence();
      updateMapSide();
      updateFunnelTitle();

      if (noMotion || !("IntersectionObserver" in window)) {
        document.querySelectorAll(".rv").forEach(el => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        }), { threshold: 0.12 });
        document.querySelectorAll(".rv").forEach(el => io.observe(el));
      }
    </script>

    <div id="dcModal" class="dc-modal" hidden>
      <div id="dcModalBackdrop" class="dc-modal-backdrop" data-dc-close></div>
      <div id="dcModalBox" class="dc-modal-box" role="dialog" aria-modal="true" aria-labelledby="dcModalTitle">
        <button type="button" class="dc-modal-close" data-dc-close aria-label="Close">×</button>
        <h3 id="dcModalTitle" class="dc-modal-title"></h3>
        <div id="dcModalSub" class="dc-modal-sub"></div>
        <dl id="dcModalBody" class="dc-modal-body"></dl>
      </div>
    </div>
  </body>
</html>
