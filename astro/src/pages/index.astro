---
import data from "../data/datacenters.json";

const dataJson = JSON.stringify(data).replace(/</g, "\\u003c");
const baseUrl = import.meta.env.BASE_URL;
// Self-hosted Leaflet (plan §6.3): 1.9.4 dist copied into public/vendor/ so
// the map needs no CDN; only the basemap tiles remain external.
const leafletBase = `${baseUrl.replace(/\/?$/, "/")}vendor/leaflet/`;
---

<html lang="en" data-lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="GRIDWATCH global data center buildout intelligence dashboard." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href={`${leafletBase}leaflet.css`} />
    <title>GRIDWATCH — Global Data Center Buildout Intelligence</title>
    <style>
      :root {
        --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        --sans: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #0a0d12;
        --sf: #11161f;
        --sf2: #151c28;
        --ln: #1e2734;
        --ln2: #2a3547;
        --ink: #e8edf6;
        --ink2: #a7b2c5;
        --mut: #66748c;
        --acc: #f5a83c;
        --acc-ink: #f5a83c;
        --acc-dim: rgba(245, 168, 60, 0.14);
        --gridline: rgba(140, 170, 220, 0.045);
        --st-ann: #9085e9;
        --st-pla: #d55181;
        --st-app: #3987e5;
        --st-con: #d95926;
        --st-op: #199e70;
        --st-rej: #e66767;
        --st-unk: #898781;
        --b0: #0d366b;
        --b1: #184f95;
        --b2: #2a78d6;
        --b3: #5598e7;
        --b4: #86b6ef;
        --b0i: #e8edf6;
        --b1i: #e8edf6;
        --b2i: #ffffff;
        --b3i: #0b1b33;
        --b4i: #0b1b33;
        --ev0: #3987e5;
        --ev1: #6da7ec;
        --ev2: #9ec5f4;
        --ev3: #898781;
        --glow: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(58, 110, 190, 0.16), transparent 70%);
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --bg: #f5f5f1;
        --sf: #fcfcfa;
        --sf2: #f2f2ed;
        --ln: #e3e2da;
        --ln2: #d2d1c7;
        --ink: #14181f;
        --ink2: #4c5566;
        --mut: #7c8698;
        --acc: #e09a2d;
        --acc-ink: #8a5a00;
        --acc-dim: rgba(224, 154, 45, 0.16);
        --gridline: rgba(60, 80, 120, 0.055);
        --st-ann: #4a3aa7;
        --st-pla: #e87ba4;
        --st-app: #2a78d6;
        --st-con: #eb6834;
        --st-op: #1baf7a;
        --st-rej: #e34948;
        --st-unk: #898781;
        --b0: #cde2fb;
        --b1: #9ec5f4;
        --b2: #5598e7;
        --b3: #256abf;
        --b4: #0d366b;
        --b0i: #14304f;
        --b1i: #14304f;
        --b2i: #ffffff;
        --b3i: #ffffff;
        --b4i: #ffffff;
        --ev0: #2a78d6;
        --ev1: #5598e7;
        --ev2: #9ec5f4;
        --ev3: #898781;
        --glow: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(42, 120, 214, 0.1), transparent 70%);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 15px/1.6 var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image:
          repeating-linear-gradient(0deg, var(--gridline) 0 1px, transparent 1px 44px),
          repeating-linear-gradient(90deg, var(--gridline) 0 1px, transparent 1px 44px);
      }

      [data-lang="en"] .zh {
        display: none !important;
      }

      [data-lang="zh"] .en {
        display: none !important;
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 24px;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        border-bottom: 1px solid var(--ln);
        backdrop-filter: blur(10px);
      }

      .topbar .wrap {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 58px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--mono);
        min-width: 0;
      }

      .brand .blk {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        flex: none;
        background: var(--acc);
        box-shadow: 0 0 12px var(--acc-dim);
      }

      .brand b {
        font-size: 15px;
        letter-spacing: 0.14em;
      }

      .brand span:not(.blk) {
        color: var(--mut);
        font-size: 11px;
        letter-spacing: 0.14em;
        white-space: nowrap;
      }

      .tgl {
        display: flex;
        border: 1px solid var(--ln2);
        border-radius: 8px;
        overflow: hidden;
      }

      .tgl:first-of-type {
        margin-left: auto;
      }

      .tgl button,
      .tabs button,
      .iconbtn {
        appearance: none;
        cursor: pointer;
        border: 0;
        color: var(--ink2);
        background: transparent;
        font: 12px var(--mono);
        letter-spacing: 0.06em;
      }

      .tgl button {
        min-height: 34px;
        padding: 7px 13px;
      }

      .tgl button.on,
      .tabs button.on {
        background: var(--acc-dim);
        color: var(--acc-ink);
      }

      .countrybar {
        display: flex;
        gap: 8px;
        max-width: 100%;
        margin: 22px 0 4px;
        padding-bottom: 4px;
        overflow-x: auto;
      }

      .countrybar button {
        appearance: none;
        flex: none;
        min-height: 34px;
        padding: 7px 13px;
        border: 1px solid var(--ln2);
        border-radius: 8px;
        color: var(--ink2);
        background: transparent;
        cursor: pointer;
        font: 12px var(--mono);
        letter-spacing: 0.06em;
      }

      .countrybar button.on {
        border-color: var(--acc);
        color: var(--acc-ink);
        background: var(--acc-dim);
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 76px 0 44px;
        background: var(--glow);
      }

      .hero .sweep {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, transparent 0%, var(--acc-dim) 50%, transparent 100%);
        background-repeat: no-repeat;
        background-size: 40% 100%;
        opacity: 0;
        animation: sweep 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s 1;
      }

      @keyframes sweep {
        0% {
          opacity: 0.9;
          background-position: -60% 0;
        }
        100% {
          opacity: 0;
          background-position: 170% 0;
        }
      }

      .kick {
        margin-bottom: 10px;
        color: var(--mut);
        font: 11px var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .kick .idx {
        margin-right: 8px;
        color: var(--acc-ink);
      }

      .live {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 22px;
        padding: 4px 12px;
        border: 1px solid var(--ln2);
        border-radius: 99px;
        color: var(--ink2);
        font: 11px var(--mono);
        letter-spacing: 0.14em;
      }

      .live .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--st-op);
        animation: pulse 2.2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          box-shadow: 0 0 0 0 rgba(25, 158, 112, 0.5);
        }
        50% {
          box-shadow: 0 0 0 6px rgba(25, 158, 112, 0);
        }
      }

      .big {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 14px;
        font-family: var(--mono);
        font-size: clamp(56px, 9vw, 104px);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: 0;
      }

      .big .unit {
        color: var(--ink2);
        font-size: 0.34em;
        font-weight: 600;
        letter-spacing: 0.04em;
      }

      .big-sub {
        position: relative;
        display: inline-block;
        max-width: 660px;
        margin-top: 14px;
        padding-top: 14px;
        color: var(--ink2);
        font-size: 16px;
      }

      .big-sub::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 3px;
        background: var(--acc);
        animation: draw 1.4s cubic-bezier(0.3, 0.7, 0.2, 1) 0.9s forwards;
      }

      .heroSplit {
        font-size: 13px;
        letter-spacing: 0.05em;
        color: var(--mut);
        font-family: var(--mono);
        margin-bottom: 8px;
      }

      .heroEq {
        margin-bottom: 6px;
        color: var(--ink2);
        font: 600 15px var(--mono);
        letter-spacing: 0.03em;
      }

      .heroEq:empty {
        display: none;
      }

      /* Odometer digit roll (§2.2): every digit sits in a clipped column whose
         0-9 strip slides to the current value. clip-path keeps the flow
         baseline intact (overflow:hidden would move it to the box bottom),
         so the TW unit stays baseline-aligned with the digits. :global()
         because the columns are injected via innerHTML at runtime. */
      :global(#heroGW .od) {
        position: relative;
        display: inline-block;
        clip-path: inset(0);
      }

      :global(#heroGW .od .odp) {
        visibility: hidden;
      }

      :global(#heroGW .od .ods) {
        position: absolute;
        top: 0;
        left: 0;
        transition: transform 90ms linear;
        will-change: transform;
      }

      :global(#heroGW .od .ods span) {
        display: block;
      }

      @keyframes draw {
        to {
          width: 120px;
        }
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 40px;
      }

      .stat,
      .card {
        background: var(--sf);
        border: 1px solid var(--ln);
        border-radius: 14px;
      }

      .stat {
        padding: 16px 18px;
      }

      .stat .v {
        font: 700 26px var(--mono);
        letter-spacing: 0;
      }

      .stat .l {
        margin-top: 3px;
        color: var(--mut);
        font-size: 12px;
      }

      .stat .bar100 {
        height: 4px;
        margin-top: 10px;
        overflow: hidden;
        border-radius: 2px;
        background: var(--sf2);
      }

      .stat .bar100 i {
        display: block;
        width: 0;
        height: 100%;
        background: var(--acc);
        transition: width 1.4s cubic-bezier(0.3, 0.7, 0.2, 1) 0.8s;
      }

      .in .bar100 i {
        width: 100%;
      }

      .sec {
        padding: 34px 0 6px;
      }

      .sec-head {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 14px;
      }

      .sec-head h2 {
        margin: 0;
        font: 600 20px var(--sans);
      }

      .sec-head .note {
        color: var(--mut);
        font-size: 13px;
      }

      .card {
        padding: 22px;
      }

      .rv {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }

      .rv.in {
        opacity: 1;
        transform: none;
      }

      .maprow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 250px;
        gap: 26px;
      }

      .realmap-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 250px;
        gap: 26px;
        margin-bottom: 24px;
      }

      .realmap {
        position: relative;
        min-height: 420px;
        overflow: hidden;
        border: 1px solid var(--ln);
        border-radius: 10px;
        background: var(--bg);
      }

      .mapfull {
        position: absolute; top: 12px; right: 12px; z-index: 1000;
        width: 36px; height: 36px; border-radius: 8px;
        border: 1px solid var(--ln); background: color-mix(in srgb, var(--sf) 88%, transparent);
        color: var(--tx); font-size: 17px; line-height: 1; cursor: pointer;
        backdrop-filter: blur(4px); box-shadow: 0 2px 8px rgba(0,0,0,.25);
      }
      .mapfull:hover { background: var(--acc-dim); }
      .mapfull.on { color: var(--acc); }

      .dotchip {
        position: absolute; bottom: 12px; left: 12px; z-index: 1000;
        padding: 5px 11px; border-radius: 999px;
        border: 1px solid var(--ln2); background: color-mix(in srgb, var(--sf) 88%, transparent);
        color: var(--mut); font: 11px var(--mono); letter-spacing: 0.05em; cursor: pointer;
        backdrop-filter: blur(4px); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      }
      .dotchip:hover { border-color: var(--acc); color: var(--ink2); }
      .dotchip.on { color: var(--acc); border-color: var(--acc); }
      .dotchip[hidden] { display: none; }

      .yearbar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        padding: 8px 12px;
        border: 1px solid var(--ln);
        border-radius: 8px;
        background: var(--sf2);
        font: 11px var(--mono);
        color: var(--mut);
        letter-spacing: 0.05em;
      }

      .yearbar button {
        width: 30px;
        height: 26px;
        border: 1px solid var(--ln2);
        border-radius: 6px;
        background: var(--sf);
        color: var(--ink2);
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
      }

      .yearbar button:hover { border-color: var(--acc); color: var(--acc); }
      .yearbar button.on { color: var(--acc); border-color: var(--acc); background: var(--acc-dim); }

      .yearbar input[type="range"] {
        flex: 0 1 260px;
        min-width: 120px;
        margin: 0;
        accent-color: var(--acc);
      }

      .yb-val {
        min-width: 64px;
        color: var(--ink);
        font-weight: 700;
      }

      .yb-val.on { color: var(--acc); }

      .yb-note {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: right;
        letter-spacing: 0;
      }

      @media (max-width: 680px) {
        .yb-note { display: none; }
      }

      .mapmode {
        align-self: start;
        padding-top: 2px;
      }

      .mapmode .k {
        color: var(--mut);
        text-transform: uppercase;
        font: 11px var(--mono);
        letter-spacing: 0.08em;
      }

      .mapmode .v {
        margin-top: 6px;
        color: var(--ink);
        font: 700 18px var(--mono);
      }

      .mapmode .d {
        margin-top: 12px;
        color: var(--ink2);
        font-size: 12px;
      }

      .leaflet-container {
        background: var(--bg);
        font: 12px var(--mono);
      }

      .leaflet-control-attribution {
        background: color-mix(in srgb, var(--sf) 88%, transparent) !important;
        color: var(--mut) !important;
      }

      .leaflet-control-attribution a {
        color: var(--ink2) !important;
      }

      .leaflet-popup-content-wrapper,
      .leaflet-popup-tip {
        border: 1px solid var(--ln2);
        color: var(--ink);
        background: var(--sf);
      }

      .leaflet-popup-content {
        margin: 11px 13px;
      }

      .leaflet-popup-content .p1 {
        margin-bottom: 5px;
        font-weight: 700;
      }

      .leaflet-popup-content .p2 {
        color: var(--ink2);
      }

      .leaflet-popup-content .p3 {
        margin-top: 7px;
        color: var(--mut);
        line-height: 1.5;
      }

      .leaflet-popup-close-button {
        color: var(--ink2) !important;
      }

      .usmap {
        display: grid;
        grid-template-columns: repeat(11, minmax(0, 1fr));
        gap: 6px;
        align-self: start;
      }

      .countrygrid,
      .subnatlist {
        display: grid;
        gap: 8px;
        align-self: start;
      }

      .countrygrid {
        grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
      }

      .geoitem {
        appearance: none;
        min-width: 0;
        padding: 10px;
        border: 1px solid var(--ln);
        border-radius: 9px;
        color: var(--ink);
        background: var(--sf2);
        cursor: pointer;
        text-align: left;
      }

      .geoitem:hover,
      .geoitem:focus-visible {
        border-color: var(--acc);
        outline: none;
      }

      .geoitem .gt {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        font: 700 12px var(--mono);
      }

      .geoitem .gn {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .geoitem .gv {
        color: var(--mut);
        font: 11px var(--mono);
      }

      .geoitem .gbar {
        display: block;
        height: 4px;
        margin-top: 8px;
        overflow: hidden;
        border-radius: 2px;
        background: var(--ln);
      }

      .geoitem .gbar i {
        display: block;
        height: 100%;
        border-radius: 2px;
        background: var(--b2);
      }

      .tile {
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        min-width: 0;
        border: 1px solid transparent;
        border-radius: 9px;
        cursor: pointer;
        user-select: none;
        transition: transform 0.15s ease, filter 0.15s ease;
      }

      .tile:hover,
      .tile:focus-visible {
        transform: translateY(-2px);
        filter: brightness(1.12);
        outline: none;
      }

      .tile.sel {
        outline: 2px solid var(--acc);
        outline-offset: 1px;
      }

      .tile .ab {
        font: 700 13px var(--mono);
      }

      .tile .tv {
        font: 10px var(--mono);
        opacity: 0.82;
      }

      .b0 {
        background: var(--b0);
        color: var(--b0i);
      }
      .b1 {
        background: var(--b1);
        color: var(--b1i);
      }
      .b2 {
        background: var(--b2);
        color: var(--b2i);
      }
      .b3 {
        background: var(--b3);
        color: var(--b3i);
      }
      .b4 {
        background: var(--b4);
        color: var(--b4i);
      }

      .mapside .side-num {
        font: 700 34px var(--mono);
      }

      .mapside .side-cap,
      .mapnote {
        color: var(--mut);
        font-size: 12px;
      }

      .mapside .side-cap {
        margin-bottom: 18px;
      }

      .legend {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-top: 8px;
      }

      .legend .lg,
      .chart-legend .lg {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--ink2);
        font: 12px var(--mono);
      }

      .legend .sw {
        width: 22px;
        height: 13px;
        border-radius: 3px;
      }

      .mapnote {
        margin-top: 18px;
        line-height: 1.5;
      }

      .tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
      }

      .tabs button {
        min-height: 34px;
        padding: 7px 14px;
        border: 1px solid var(--ln2);
        border-radius: 8px;
      }

      .tabs button.on {
        border-color: var(--acc);
      }

      .wavebox {
        display: flex;
        gap: 12px;
        align-items: stretch;
      }

      .wy {
        width: 46px;
        flex: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 4px 0 24px;
        text-align: right;
        color: var(--mut);
        font: 10px var(--mono);
        user-select: none;
      }

      .wavearea {
        flex: 1;
        min-width: 0;
      }

      .wave {
        position: relative;
        display: flex;
        align-items: flex-end;
        gap: 8px;
        height: 250px;
        padding-top: 26px;
        background: repeating-linear-gradient(
          to top,
          transparent 0,
          transparent calc(25% - 1px),
          var(--ln2) calc(25% - 1px),
          var(--ln2) 25%
        );
        background-size: 100% 212px;
        background-position: bottom;
        background-repeat: no-repeat;
        border-bottom: 1px solid var(--ln2);
      }

      .wx {
        display: flex;
        gap: 8px;
        margin-top: 8px;
      }

      .chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 16px;
      }

      .chart-legend .sw {
        width: 12px;
        height: 12px;
        border-radius: 3px;
      }

      .chart-legend .swline {
        height: 3px;
        border-radius: 2px;
        background: var(--acc);
      }

      .filters {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
      }

      .filters select {
        appearance: none;
        min-height: 34px;
        padding: 7px 28px 7px 11px;
        border: 1px solid var(--ln2);
        border-radius: 8px;
        color: var(--ink);
        background-color: var(--sf2);
        background-image:
