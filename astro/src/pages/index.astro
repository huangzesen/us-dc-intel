              <div class="realmap" id="realMap" aria-label="interactive geographic map"><button id="mapFull" class="mapfull" type="button" title="Fullscreen map / 全屏地图" aria-label="Fullscreen map / 全屏地图">⛶</button><button id="dotToggle" class="dotchip" type="button" aria-pressed="true" hidden></button></div>
              <div class="mapmode">
